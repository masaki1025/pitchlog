{
  "schemaVersion": 1,
  "authority": {
    "id": "ADR-003 D-11 入力範囲表",
    "source": "docs/adr/ADR-003-domain-calc-method.md",
    "section": "### D-11: (b) の検査設計(**決定** — 要件書 v2.2 の再定義後の条文に対する具体化)",
    "tableTarget": "(β)①〜⑤ の集計"
  },
  "vocabularySchema": {
    "source": "backend/domain/vocabulary.schema.json",
    "primitiveUnion": "#/$defs/NumericPrimitive",
    "numericValueUnion": "#/$defs/NumericValue"
  },
  "derivation": {
    "axisExtraction": {
      "syntax": "slash-separated-bold-list",
      "separator": "/"
    },
    "caseIdentity": "authority-id + axis-partition + schema-boundary",
    "combinationRules": [
      {
        "axes": [
          "rounding-boundary",
          "sign"
        ],
        "operation": "cartesian-product",
        "partitions": {
          "rounding-boundary": [
            "before",
            "exact",
            "after"
          ],
          "sign": [
            "positive",
            "negative"
          ]
        }
      },
      {
        "axis": "scale-boundary",
        "operation": "schema-minimum-maximum-per-primitive"
      },
      {
        "axesFrom": "authority-row",
        "operation": "cover-every-partition"
      }
    ],
    "concreteValuePolicy": {
      "positiveRoundingBoundary": "0.3335",
      "negativeRoundingBoundary": "-1.5",
      "roundingNeighborStep": "0.0001",
      "overflow": "signed-64-bit-maximum-plus-one"
    }
  },
  "axes": [
    {
      "id": "rounding-boundary",
      "sourceText": "丸め境界の直前・一致・直後",
      "partitions": [
        "before",
        "exact",
        "after"
      ],
      "schemaPointers": [
        "#/$defs/FixedDecimal/properties/rounding",
        "#/$defs/Percentage/properties/rounding"
      ]
    },
    {
      "id": "scale-boundary",
      "sourceText": "scale の上下限",
      "partitions": [
        "minimum",
        "maximum"
      ],
      "schemaPointers": [
        "#/$defs/FixedDecimal/properties/scale",
        "#/$defs/Percentage/properties/scale"
      ]
    },
    {
      "id": "sign",
      "sourceText": "正・負・0",
      "partitions": [
        "positive",
        "negative",
        "zero"
      ],
      "schemaPointers": [
        "#/$defs/NumericValue"
      ]
    },
    {
      "id": "zero-denominator",
      "sourceText": "分母 0",
      "partitions": [
        "zero"
      ],
      "schemaPointers": [
        "#/$defs/RationalValue/properties/denominator"
      ]
    },
    {
      "id": "empty-aggregate",
      "sourceText": "集計対象 0 件(全欠損 — 分母 0 と別 case)",
      "partitions": [
        "all-missing"
      ],
      "schemaPointers": [
        "#/$defs/NumericValue"
      ]
    },
    {
      "id": "remainder",
      "sourceText": "剰余 0・1・分母−1(投球回)",
      "partitions": [
        "zero",
        "one",
        "denominator-minus-one"
      ],
      "schemaPointers": [
        "#/$defs/MixedFraction/properties/denominator",
        "#/$defs/MixedFraction/properties/zeroRemainder"
      ]
    },
    {
      "id": "nullable",
      "sourceText": "nullable",
      "partitions": [
        "null"
      ],
      "schemaPointers": [
        "#/$defs/NumericValue",
        "#/$defs/NullSubstitute/properties/substitute"
      ]
    },
    {
      "id": "overflow",
      "sourceText": "オーバーフロー",
      "partitions": [
        "signed-64-bit-maximum-plus-one"
      ],
      "schemaPointers": [
        "#/$defs/IntegerValue/properties/value"
      ]
    }
