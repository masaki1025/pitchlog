        "schema": "#/$defs/ExtremumExpression/properties/operator"
      },
      {
        "id": "max",
        "schema": "#/$defs/ExtremumExpression/properties/operator"
      },
      {
        "id": "explicit-rounding",
        "schema": "#/$defs/RoundingExpression"
      },
      {
        "id": "finite-reducer",
        "schema": "#/$defs/ReducerRule/properties/maximumItems"
      },
      {
        "id": "input-type",
        "schema": "#/$defs/FieldDeclaration/properties/type"
      },
      {
