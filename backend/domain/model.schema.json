      },
      {
        "id": "input-unit",
        "schema": "#/$defs/FieldDeclaration/properties/unit"
      },
      {
        "id": "input-scale",
        "schema": "#/$defs/FieldDeclaration/properties/scale"
      },
      {
        "id": "output-type",
        "schema": "#/$defs/OutputField/properties/type"
      },
      {
        "id": "output-range",
        "schema": "#/$defs/OutputField/properties/range"
      },
      {
        "id": "output-unit",
        "schema": "#/$defs/OutputField/properties/unit"
      },
      {
        "id": "output-scale",
        "schema": "#/$defs/OutputField/properties/scale"
      },
      {
        "id": "nullable",
        "schema": "#/$defs/FieldDeclaration/properties/nullable"
      },
      {
        "id": "enum-display-map",
        "schema": "vocabulary.schema.json#/$defs/EnumDisplayMap"
      },
      {
        "id": "declarative-display-rule",
        "schema": "vocabulary.schema.json"
      }
    ],
    "targetFieldSelectors": [
      {
        "id": "calculation-output-user-visible-numeric",
        "collection": "#/$defs/Calculation/properties/outputs",
        "itemSchema": "#/$defs/OutputField",
        "fieldIdProperty": "fieldId",
        "visibilityProperty": "visibility",
        "visibleValue": "user-visible",
        "typeKindProperty": "type.kind",
        "numericTypeKinds": [
          "integer",
          "numeric-value"
        ]
      }
    ],
    "vocabularyReferences": [
      "vocabulary.schema.json",
      "vocabulary.schema.json#/$defs/NumericValue",
      "vocabulary.schema.json#/$defs/DisplayAtom",
      "vocabulary.schema.json#/$defs/ResolvedName"
    ]
  }
}
