{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "calculationId",
    "source",
    "aggregate",
    "entryProjection"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "calculationId": {
      "const": "pitcherAppearances"
    },
    "source": {
      "type": "object",
      "required": [
        "scopeRelation",
        "memberRelation",
        "binding",
        "completeColumn",
        "proofKinds",
        "requiresCompleteSupply",
        "memberCountColumn",
        "expectedGameCountBind"
      ],
      "additionalProperties": false,
      "properties": {
        "scopeRelation": {
          "const": "appearance_scope"
        },
        "memberRelation": {
          "const": "appearance_members"
        },
        "binding": {
          "const": [
            "tenant_id",
            "game_id",
            "fact_version_id",
            "revision",
            "source_set_sha256"
          ]
        },
        "completeColumn": {
          "const": "supply_complete"
        },
        "proofKinds": {
          "const": [
            "defensive-half-entry",
            "pitcher-defensive-entry"
          ]
        },
        "requiresCompleteSupply": {
          "const": true
        },
        "memberCountColumn": {
          "const": "member_count"
        },
        "expectedGameCountBind": {
          "const": "expected_game_count"
        }
      }
    },
    "aggregate": {
      "type": "object",
      "required": [
        "operation",
        "key",
        "playerKey",
        "missingSupply"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "count-distinct"
        },
        "key": {
          "const": "game_id"
        },
        "playerKey": {
          "const": "player_id"
        },
        "missingSupply": {
          "const": "source_unavailable"
        }
      }
    },
    "entryProjection": {
      "const": {
        "sourceRelation": "appearance_transition",
        "sourceKinds": [
          "start",
          "play",
          "substitution",
          "reopen"
        ],
        "halfDefender": {
          "top": "home",
          "bottom": "away"
        },
        "continueOutcomes": [
          "no-end",
          "extra-continue",
          "tiebreak-continue"
        ],
        "halfReason": "defensive-half-entry",
        "substitutionReason": "pitcher-defensive-entry",
        "knownOutcomes": [
          "no-end",
          "normal-end",
          "extra-continue",
          "limit-draw",
          "tiebreak-continue",
          "cold-end",
          "walk-off"
        ],
        "knownXMarks": [
          "recorded-score",
          "x-mark"
        ]
      }
    }
  }
}
