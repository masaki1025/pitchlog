{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "expectationsAreGeneratorInputs",
    "properties",
    "metricIds",
    "unestablished"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "const": "candidate-property-test-plan"
    },
    "expectationsAreGeneratorInputs": {
      "const": false
    },
    "properties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scope",
          "invariant",
          "caseIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "invariant": {
            "type": "string",
            "minLength": 1
          },
          "caseIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "metricIds": {
      "type": "array",
      "minItems": 26,
      "maxItems": 26,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "unestablished": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
