name: CI

on:
  pull_request:
    # 本文の編集は .github/workflows/pr-body.yml が担う。ここへ edited を入れると
    # 委任証拠コメントの差し替えだけで 1 時間の検査がキャンセル・再実行される。
    types: [opened, synchronize, reopened]
  push:
    branches:
      - develop
      - main
  workflow_dispatch:

concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  secrets:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      # gitleaks-action が PR コミット一覧を GitHub API で取得するため必要
      pull-requests: read
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - uses: gitleaks/gitleaks-action@e0c47f4f8be36e29cdc102c57e68cb5cbf0e8d1e # v3.0.0
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          GITLEAKS_ENABLE_COMMENTS: "false"
          GITLEAKS_ENABLE_UPLOAD_ARTIFACT: "false"
          GITLEAKS_ENABLE_SUMMARY: "false"

  docs-lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9 # v9.0.0
        with:
          version: "0.8.13"
          enable-cache: true
          prune-cache: true
      - run: uv python install
      - uses: lycheeverse/lychee-action@e7477775783ea5526144ba13e8db5eec57747ce8 # v2.9.0
        with:
          args: --offline --root-dir "$(pwd)" --no-progress --exclude-path docs/legacy './**/*.md'
      - run: uv run python scripts/check_docs_status.py
      - run: uv run python scripts/check_design_propagation.py
      - run: uv run python scripts/check_doc_coverage.py

  # 静的検査は pytest と分離し、分割実行を待たずに赤を返す。
  harness-static:
    runs-on: ubuntu-latest
    steps:
      # manifest.json の source_commit を解決するため fetch-depth: 0 が必須(既定の 1 では到達できない)。
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      # runtime と runner の試験は mise.toml に固定した Node を使う。
      - uses: jdx/mise-action@3c2e0cf82a5b2e5249f0d3635a4d83d0ae861518 # v4.2.5
        with:
          version: "2026.8.6"
          install: true
          cache: false
      - uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9 # v9.0.0
        with:
          version: "0.8.13"
          enable-cache: true
          prune-cache: true
      - run: uv python install
      - run: uv sync --locked --dev
      - run: uv run python scripts/check_frozen_baselines.py --ci
      - run: uv run python scripts/check_input_axes_three_way_parity.py --ci
      - run: uv run python tests/test_census_baseline_check.py
      - run: uv run ruff check .
      - run: uv run ty check

  # 30,777 件を 4 分割する。各シャードは同じ全件集合の部分集合を実行し、
  # 合計が全件と一致することは harness 集約ジョブが機械検証する。
  harness-shard:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        shard: [0, 1, 2, 3]
    env:
      PYTHONPATH: ${{ github.workspace }}/scripts
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - uses: jdx/mise-action@3c2e0cf82a5b2e5249f0d3635a4d83d0ae861518 # v4.2.5
        with:
          version: "2026.8.6"
          install: true
          cache: false
      - uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9 # v9.0.0
        with:
          version: "0.8.13"
          enable-cache: true
          prune-cache: true
      - run: uv python install
      - run: uv sync --locked --dev
      - name: pytest (shard ${{ matrix.shard }}/4)
        run: >-
          uv run python -m pytest -c pyproject.toml tests/
          --ignore=tests/domain/boot
          --ignore=tests/domain/mut
          --ignore=tests/test_plan_generation.py
          --ignore=tests/test_step_history_audit.py
          -p pytest_shard_plugin
          --shard-count 4
          --shard-index ${{ matrix.shard }}
          --durations=25

  # 必須チェック名 ``harness`` を維持する集約ジョブ。失敗・キャンセル・
  # 予期しない skip をここで拒否する(GitHub の required status checks は
  # ジョブ単位で評価されるため、集約で全シャードを代表させる)。
  harness:
    needs: [harness-static, harness-shard]
    if: always()
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9 # v9.0.0
        with:
          version: "0.8.13"
          enable-cache: true
          prune-cache: true
      - run: uv python install
      - run: uv sync --locked --dev
      # 全シャードの収集結果が全件と一致することを、実行後に改めて検証する。
      - run: uv run python scripts/pytest_shards.py verify --suite harness
      - name: シャード結果の厳密確認
        env:
          NEEDS: ${{ toJSON(needs) }}
        run: |
          python3 - <<'PY'
          import json
          import os

          needs = json.loads(os.environ['NEEDS'])
          bad = {name: value.get('result') for name, value in needs.items()
                 if value.get('result') != 'success'}
          if bad:
              raise SystemExit(f'必須ジョブが success ではない: {bad}')
          print('all required jobs succeeded')
          PY

  # NFR-018 (e) BOOT-ACTIVATION の機構・負例・正例と、計画・履歴監査を常時実行する。
  # harness の単体テストとは所有を分け、同じテストを二重実行しない。
  consistency:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9 # v9.0.0
        with:
          version: "0.8.13"
          enable-cache: true
          prune-cache: true
      - run: uv python install
      - run: uv sync --locked --dev
      # BOOT-REPORT は「出力のない緑は本規定の充足とみなさない」と定めるので、
      # 検査器の単体テストとは別に、実状態に対して毎回出力させる。
      - run: uv run python -m pitchlog.domaincheck.boot.report --root .
        env:
          PYTHONPATH: backend/src
      # 存在確認だけでは古い出力を受理するため、HEAD と入力 digest を再実測する。
      - run: uv run python -m pitchlog.domaincheck.boot.report --root . --verify
        env:
          PYTHONPATH: backend/src
      # 対象 pytest をこのプロセスが実際に完走させた後でのみ証跡を生成する。
      - run: >-
          uv run python -m pitchlog.domaincheck.activation_evidence
          --root . --output /tmp/boot-activation-runtime.json
          --run-id "${{ github.run_id }}" --event "${{ github.event_name }}"
          --execute-command "uv run pytest -c pyproject.toml tests/domain/boot/
          tests/test_plan_generation.py tests/test_step_history_audit.py"
        env:
          PYTHONPATH: backend/src
      - run: >-
          uv run python -m pitchlog.domaincheck.activation_evidence
          --root . --output /tmp/boot-activation-runtime.json --verify
          --expected-command "uv run pytest -c pyproject.toml tests/domain/boot/
          tests/test_plan_generation.py tests/test_step_history_audit.py"
        env:
          PYTHONPATH: backend/src
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: boot-activation-evidence
          path: /tmp/boot-activation-runtime.json
          if-no-files-found: error

  # 変異処理内部の 10 分・30 分制限とは別に、ジョブ自体にも上限を持たせる。
  # SQL 変異は実 PostgreSQL を使うため backend と同じ image を先に取得する。
  mutation:
    runs-on: ubuntu-latest
    timeout-minutes: 40
    services:
      postgres:
        image: postgres:17.11-bookworm
        env:
          POSTGRES_USER: pitchlog_ci_admin
          POSTGRES_PASSWORD: pitchlog-ci-${{ github.run_id }}-${{ github.run_attempt }}
          POSTGRES_DB: pitchlog_test
          POSTGRES_INITDB_ARGS: "--encoding=UTF8 --locale-provider=libc --locale=C.UTF-8"
        ports:
          - "5432:5432"
        options: >-
          --health-cmd "pg_isready -h 127.0.0.1 -U pitchlog_ci_admin -d pitchlog_test"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 12
          --health-start-period 10s
    env:
      PITCHLOG_TEST_ADMIN_DSN: postgresql://pitchlog_ci_admin:pitchlog-ci-${{ github.run_id }}-${{ github.run_attempt }}@127.0.0.1:5432/pitchlog_test
      PITCHLOG_TEST_ROLE_DSN: postgresql://pitchlog_test_role:pitchlog-role-${{ github.run_id }}-${{ github.run_attempt }}@127.0.0.1:5432/pitchlog_test
      PITCHLOG_MIGRATION_DATABASE_URL: postgresql://pitchlog_ci_admin:pitchlog-ci-${{ github.run_id }}-${{ github.run_attempt }}@127.0.0.1:5432/pitchlog_test
      PITCHLOG_STAGE_A_OWNER_DSN: postgresql://pitchlog_owner:pitchlog-owner-${{ github.run_id }}-${{ github.run_attempt }}@127.0.0.1:5432/pitchlog_stage_a_ci
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9 # v9.0.0
        with:
          version: "0.8.13"
          enable-cache: true
          prune-cache: true
      - run: uv python install
      - run: uv sync --locked --dev
      - run: uv sync --project backend --locked --dev
      - run: uv run pytest -c pyproject.toml tests/domain/mut/

  # NFR-021 受入証跡の append-only 統合時検査(設計書 10.1「試行の排他と採番」)。
  # paths filter は付けない: フィルタ自体が誤ると検査が黙って通り fail-closed に反するため。
  # 新規レコードが 0 件なら exit 0 になるので、常時実行でも実害はない(標準ライブラリのみで軽い)。
  # 三点差分の merge-base を解決するため fetch-depth: 0 が必須(既定の 1 では base に到達できない)。
  # develop を base とする pull_request 以外(main 宛 PR・push・workflow_dispatch)は
  # スクリプト側が理由を stdout へ出して exit 0 とする。
  nfr021-append-only:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9 # v9.0.0
        with:
          version: "0.8.13"
          enable-cache: true
          prune-cache: true
      - run: uv python install
      - run: uv run python scripts/check_nfr021_append_only.py

  # テナント境界の迂回検査は検査器自身の変更でも必ず走らせる。
  # paths filter は付けない: フィルタ自体が誤ると検査が黙って通り fail-closed に反するため。
  # 三点差分の merge-base を解決するため fetch-depth: 0 が必須(既定の 1 では base に到達できない)。
  tenant-boundary-bypass:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9 # v9.0.0
        with:
          version: "0.8.13"
          enable-cache: true
          prune-cache: true
      - run: uv python install
      # 比較元は CI が与える(検査対象の資産に自己申告させない — 敵対レビュー 3 周目 7A)。
      # 資産が base_ref を宣言できると HEAD を指定して差分を空にでき、検査母集団が 0 件になって
      # 迂回検査そのものが no-op になる。pull_request 以外(develop/main への push・手動実行)は
      # 比較対象の PR が無いため、検査器側の凍結された既定値を使う。
      - name: tenant-boundary 迂回検査
        env:
          PR_BASE_REF: ${{ github.base_ref }}
        run: |
          if [ -n "$PR_BASE_REF" ]; then
            uv run python scripts/check_tenant_boundary_bypass.py --base-ref "origin/$PR_BASE_REF"
          else
            uv run python scripts/check_tenant_boundary_bypass.py
          fi

  # 適合ベクタ・runner・ブリッジの変更でも frontend の検査を走らせる。
  frontend-changes:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: read
    outputs:
      frontend: ${{ steps.filter.outputs.frontend }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - uses: dorny/paths-filter@ceb8a2b8f2d89434be7ff52d3de7ec3738c5cc9d # v4.0.3
        id: filter
        with:
          base: ${{ github.ref_name }}
          filters: |
            frontend:
              - 'frontend/**'
              - 'frontend/public/domain/**'
              - 'frontend/scripts/domain-*/**'
              - 'mise.toml'
              - 'frontend/pnpm-lock.yaml'
              - '.github/workflows/ci.yml'
              - 'contracts/**'
              - 'scripts/design_relations/sync-protocol.json'
              - 'tests/domain/runners/**'
              - 'backend/src/pitchlog/domaincheck/runners/**'

  frontend:
    needs: frontend-changes
    if: >-
      github.event_name == 'workflow_dispatch' ||
      needs.frontend-changes.outputs.frontend == 'true'
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: frontend
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      # Node 版は mise.toml を正本として mise に解決させ、別の版指定を持たない。
      - uses: jdx/mise-action@3c2e0cf82a5b2e5249f0d3635a4d83d0ae861518 # v4.2.5
        with:
          version: "2026.8.6"
          install: true
          cache: false
      - run: corepack enable
      - run: pnpm install --frozen-lockfile
      - run: pnpm exec eslint .
      - run: pnpm exec prettier --check .
      - run: pnpm exec vue-tsc --noEmit
      - run: pnpm exec depcruise src --validate
      - run: pnpm run build:domain
      - run: git diff --exit-code -- public/domain/pitchlog-domain.js public/domain/pitchlog-domain.json
      - run: pnpm run build
      - run: pnpm test -- --run

  backend-changes:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: read
    outputs:
      backend: ${{ steps.filter.outputs.backend }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - uses: dorny/paths-filter@ceb8a2b8f2d89434be7ff52d3de7ec3738c5cc9d # v4.0.3
        id: filter
        with:
          base: ${{ github.ref_name }}
          filters: |
            backend:
              - 'backend/**'
              - 'contracts/**'
              - '.github/workflows/ci.yml'
              - 'frontend/public/domain/**'
              - '.dockerignore'
              - 'mise.toml'

  # lint/型は 1 回だけ実行し、pytest の分割と並走させる。
  backend-static:
    needs: backend-changes
    if: >-
      github.event_name == 'workflow_dispatch' ||
      needs.backend-changes.outputs.backend == 'true'
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: backend
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9 # v9.0.0
        with:
          version: "0.8.13"
          enable-cache: true
          prune-cache: true
          cache-dependency-glob: |
            backend/pyproject.toml
            backend/uv.lock
      - run: uv python install
      - run: uv sync --locked --dev
      - run: uv run ruff check .
      - run: uv run ruff format --check .
      - run: uv run ty check

  # 7,432 件を 4 分割する。各シャードは独立した PostgreSQL service を持ち、
  # DB 試験の隔離はジョブ単位で保たれる。カバレッジは全シャードで計測し、
  # 集約ジョブで結合する(測定範囲を狭めない)。
  backend-shard:
    needs: backend-changes
    if: >-
      github.event_name == 'workflow_dispatch' ||
      needs.backend-changes.outputs.backend == 'true'
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        shard: [0, 1, 2, 3]
    services:
      postgres:
        image: postgres:17.11-bookworm
        env:
          POSTGRES_USER: pitchlog_ci_admin
          POSTGRES_PASSWORD: pitchlog-ci-${{ github.run_id }}-${{ github.run_attempt }}
          POSTGRES_DB: pitchlog_test
          POSTGRES_INITDB_ARGS: "--encoding=UTF8 --locale-provider=libc --locale=C.UTF-8"
        ports:
          - "5432:5432"
        options: >-
          --health-cmd "pg_isready -h 127.0.0.1 -U pitchlog_ci_admin -d pitchlog_test"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 12
          --health-start-period 10s
    env:
      PYTHONPATH: ${{ github.workspace }}/scripts
      PITCHLOG_TEST_ADMIN_DSN: postgresql://pitchlog_ci_admin:pitchlog-ci-${{ github.run_id }}-${{ github.run_attempt }}@127.0.0.1:5432/pitchlog_test
      PITCHLOG_TEST_ROLE_DSN: postgresql://pitchlog_test_role:pitchlog-role-${{ github.run_id }}-${{ github.run_attempt }}@127.0.0.1:5432/pitchlog_test
      PITCHLOG_MIGRATION_DATABASE_URL: postgresql://pitchlog_ci_admin:pitchlog-ci-${{ github.run_id }}-${{ github.run_attempt }}@127.0.0.1:5432/pitchlog_test
      PITCHLOG_STAGE_A_OWNER_DSN: postgresql://pitchlog_owner:pitchlog-owner-${{ github.run_id }}-${{ github.run_attempt }}@127.0.0.1:5432/pitchlog_stage_a_ci
      COVERAGE_FILE: .coverage.shard${{ matrix.shard }}
    defaults:
      run:
        working-directory: backend
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      # DB の SQL 生成試験と domainrt は mise.toml の Node 版を使う。
      - uses: jdx/mise-action@3c2e0cf82a5b2e5249f0d3635a4d83d0ae861518 # v4.2.5
        with:
          version: "2026.8.6"
          install: true
          cache: false
      # SQL 生成試験の生成器は frontend の typescript を読むため、frontend の依存を入れる。
      - run: corepack enable
      - run: pnpm install --frozen-lockfile
        working-directory: frontend
      - uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9 # v9.0.0
        with:
          version: "0.8.13"
          enable-cache: true
          prune-cache: true
          cache-dependency-glob: |
            backend/pyproject.toml
            backend/uv.lock
      - run: uv python install
      - run: uv sync --locked --dev
      - name: pytest (shard ${{ matrix.shard }}/4)
        run: >-
          uv run python -m pytest -c pyproject.toml
          -p pytest_shard_plugin
          --shard-count 4
          --shard-index ${{ matrix.shard }}
          --cov
          --cov-report=term
          --durations=25
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: backend-coverage-${{ matrix.shard }}
          path: backend/.coverage.shard${{ matrix.shard }}*
          if-no-files-found: error

  # 必須チェック名 ``backend`` を維持する集約ジョブ。全シャードの success を
  # 厳密に要求し、カバレッジを結合して測定範囲を分割前と同一に保つ。
  # 段階A起動と配布イメージの疎通もここで 1 回だけ実行する。
  backend:
    needs: [backend-changes, backend-static, backend-shard]
    if: >-
      always() && (github.event_name == 'workflow_dispatch' ||
      needs.backend-changes.outputs.backend == 'true')
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:17.11-bookworm
        env:
          POSTGRES_USER: pitchlog_ci_admin
          POSTGRES_PASSWORD: pitchlog-ci-${{ github.run_id }}-${{ github.run_attempt }}
          POSTGRES_DB: pitchlog_test
          POSTGRES_INITDB_ARGS: "--encoding=UTF8 --locale-provider=libc --locale=C.UTF-8"
        ports:
          - "5432:5432"
        options: >-
          --health-cmd "pg_isready -h 127.0.0.1 -U pitchlog_ci_admin -d pitchlog_test"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 12
          --health-start-period 10s
    env:
      PITCHLOG_TEST_ADMIN_DSN: postgresql://pitchlog_ci_admin:pitchlog-ci-${{ github.run_id }}-${{ github.run_attempt }}@127.0.0.1:5432/pitchlog_test
      PITCHLOG_TEST_ROLE_DSN: postgresql://pitchlog_test_role:pitchlog-role-${{ github.run_id }}-${{ github.run_attempt }}@127.0.0.1:5432/pitchlog_test
      PITCHLOG_MIGRATION_DATABASE_URL: postgresql://pitchlog_ci_admin:pitchlog-ci-${{ github.run_id }}-${{ github.run_attempt }}@127.0.0.1:5432/pitchlog_test
      PITCHLOG_STAGE_A_OWNER_DSN: postgresql://pitchlog_owner:pitchlog-owner-${{ github.run_id }}-${{ github.run_attempt }}@127.0.0.1:5432/pitchlog_stage_a_ci
    defaults:
      run:
        working-directory: backend
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - name: シャード結果の厳密確認
        env:
          NEEDS: ${{ toJSON(needs) }}
        run: |
          python3 - <<'PY'
          import json
          import os

          needs = json.loads(os.environ['NEEDS'])
          bad = {name: value.get('result') for name, value in needs.items()
                 if value.get('result') != 'success'}
          if bad:
              raise SystemExit(f'必須ジョブが success ではない: {bad}')
          print('all required jobs succeeded')
          PY
      - uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9 # v9.0.0
        with:
          version: "0.8.13"
          enable-cache: true
          prune-cache: true
          cache-dependency-glob: |
            backend/pyproject.toml
            backend/uv.lock
      - run: uv python install
      - run: uv sync --locked --dev
      # 分割実行の被覆を収集したテスト ID で検証する(DB 試験の被覆も含む)。
      - run: uv run python ../scripts/pytest_shards.py verify --suite backend --require-db
      - uses: actions/download-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          pattern: backend-coverage-*
          merge-multiple: true
          path: backend
      # pytest用DBと分離し、実migrationの所有者とS0を一致させる。
      - run: |
          uv run python - <<'PY'
          import os
          import psycopg
          from psycopg import sql
          from psycopg.conninfo import conninfo_to_dict

          admin_dsn = os.environ['PITCHLOG_TEST_ADMIN_DSN']
          owner_dsn = os.environ['PITCHLOG_STAGE_A_OWNER_DSN']
          owner_password = conninfo_to_dict(owner_dsn)['password']
          with psycopg.connect(admin_dsn, autocommit=True) as connection:
              connection.execute(
                  sql.SQL('CREATE ROLE pitchlog_owner LOGIN NOSUPERUSER NOBYPASSRLS NOCREATEROLE NOCREATEDB NOREPLICATION NOINHERIT PASSWORD {}').format(
                      sql.Literal(owner_password)
                  )
              )
              connection.execute(
                  sql.SQL('CREATE DATABASE {} OWNER {}').format(
                      sql.Identifier('pitchlog_stage_a_ci'),
                      sql.Identifier('pitchlog_owner'),
                  )
              )
              # 認可カタログは同一クラスタ内の全非template DBのPUBLIC権限も対象にする。
              # pytest用DBをPUBLIC既定のまま残すとS3のINITIAL-VERIFIER-GLOBALだけが
              # 失敗するため、seed DB側を閉じて製品検査の意味を変えない。
              connection.execute(
                  "REVOKE CONNECT, TEMPORARY ON DATABASE pitchlog_test FROM PUBLIC"
              )
          PY
      - run: uv run alembic upgrade 0033_game_rules_immutable
        env:
          PITCHLOG_MIGRATION_DATABASE_URL: ${{ env.PITCHLOG_STAGE_A_OWNER_DSN }}
      # S1認可後にだけ0033をownerで適用する。S4公開判定は行わない。
      - run: |
          uv run python - <<'PY'
          import os
          import psycopg
          from psycopg.conninfo import conninfo_to_dict, make_conninfo
          from pitchlog.db.stage_a_startup import advance_stage_a_from_s0

          admin_dsn = os.environ['PITCHLOG_TEST_ADMIN_DSN']
          owner_dsn = os.environ['PITCHLOG_STAGE_A_OWNER_DSN']
          stage_db = conninfo_to_dict(owner_dsn)['dbname']
          stage_admin_dsn = make_conninfo(admin_dsn, dbname=stage_db)
          result = advance_stage_a_from_s0(
              owner_dsn=owner_dsn, applicator_dsn=stage_admin_dsn
          )
          assert result.completed_stage == 'S3'
          assert result.publishable is False
          PY
      - run: uv run alembic current --check-heads
        env:
          PITCHLOG_MIGRATION_DATABASE_URL: ${{ env.PITCHLOG_STAGE_A_OWNER_DSN }}
      - run: uv run alembic check
        env:
          PITCHLOG_MIGRATION_DATABASE_URL: ${{ env.PITCHLOG_STAGE_A_OWNER_DSN }}
      # x86_64 の配布イメージで起動時の hash 照合と常駐 Node の疎通を検証する。
      - name: D-2 配布イメージの疎通
        run: |
          docker build -f backend/Dockerfile -t pitchlog-backend:ci .
          test "$(docker run --rm --entrypoint node pitchlog-backend:ci --version)" = "v24.16.0"
          docker run --rm -i --entrypoint python pitchlog-backend:ci - <<'PY'
          import base64
          import json
          import os
          import secrets

          os.environ['PITCHLOG_TOKEN_SIGNING_KEY_B64'] = base64.b64encode(secrets.token_bytes(32)).decode('ascii')
          from pitchlog.api.app import create_app
          from pitchlog.domainrt import open_domain_host

          assert create_app()
          value = '18446744073709551621'
          with open_domain_host() as host:
              response = host.call('ping', json.dumps({'value': value}))
          assert response == json.dumps({'ok': True, 'value': value}, separators=(',', ':'))
          print('FastAPI startup and domain ping OK')
          PY
        working-directory: ${{ github.workspace }}
      - name: カバレッジの結合
        env:
          COVERAGE_FILE: .coverage
        run: |
          uv run coverage combine
          uv run coverage report
