{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pitchlog.local/contracts/field-regions/field_region_seed_schema_v1.json",
  "title": "Pitchlog field region seed schema v1",
  "version": "field_region_seed_schema_v1",
  "description": "付録B-6 の参照データ契約。regions 配列の順序そのものが規則の一部であり、複数の領域に含まれる点では先に定義された領域が優先する。1 つの守備位置は複数の領域を持てる。座標は 0〜1・左下原点で、各成分は ADR-003 D-14-e の整数・decimal・有理数のいずれかで記録する。",
  "type": "object",
  "required": [
    "schemaVersion",
    "version",
    "source",
    "fieldImage",
    "regions",
    "tieBreak"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "version": {
      "type": "string",
      "pattern": "^[a-z]+(?:_[a-z]+)*_v[1-9][0-9]*$"
    },
    "source": {"$ref": "#/$defs/source"},
    "description": {"type": "string", "minLength": 1},
    "fieldImage": {
      "description": "画像の元寸法と、左上原点の画像座標から左下原点の保存座標への正規化の対応。",
      "type": "object",
      "required": ["originalWidth", "originalHeight", "normalization"],
      "additionalProperties": false,
      "properties": {
        "originalWidth": {"type": "integer", "minimum": 1},
        "originalHeight": {"type": "integer", "minimum": 1},
        "normalization": {
          "type": "object",
          "required": ["sourceOrigin", "targetOrigin", "xMapping", "yMapping"],
          "additionalProperties": false,
          "properties": {
            "sourceOrigin": {"const": "top-left"},
            "targetOrigin": {"const": "bottom-left"},
            "xMapping": {"const": "x / originalWidth"},
            "yMapping": {"const": "1 - y / originalHeight"}
          }
        }
      }
    },
    "regions": {
      "description": "守備位置領域。複数の領域に含まれる点は配列の先頭側に帰属するため、並べ替えると判定結果が変わる。",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/region"}
    },
    "directionOrigin": {"$ref": "#/$defs/point"},
    "directionSectors": {
      "description": "打球方向の区分角。配列は左翼線から右翼線への定義順を保つ。",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/directionSector"}
    },
    "tieBreak": {"const": "first-defined-region-wins"}
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["repository", "tag", "path"],
      "additionalProperties": false,
      "oneOf": [
        {"required": ["blobSha"]},
        {"required": ["blobShaStatus"]}
      ],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "blobSha": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
        "blobShaStatus": {"const": "取得は委任元が行う"}
      }
    },
    "numericValue": {
      "description": "ADR-003 D-14-e の整数・decimal・有理数。採用する形は各契約の条文による。丸め規則は要件書 付録A-1 と ADR-003 D-14-e を参照する。数値の字面は tests/test_field_geometry_numeric_lexemes.py で字句検査する。",
      "$comment": "JSON Schema は数値リテラルの綴りを保持しない。-0 や 1.0 の字面は契約ファイルの原文に対する検査で拒否する。",
      "oneOf": [
        {"type": "integer"},
        {"$ref": "#/$defs/decimal"},
        {"$ref": "#/$defs/rational"}
      ]
    },
    "decimal": {
      "description": "value / scale。scale は 10 の冪。",
      "type": "object",
      "required": ["value", "scale"],
      "additionalProperties": false,
      "properties": {
        "value": {"type": "integer"},
        "scale": {
          "type": "integer",
          "enum": [1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000, 1000000000, 10000000000, 100000000000, 1000000000000, 10000000000000, 100000000000000, 1000000000000000]
        }
      }
    },
    "rational": {
      "description": "分子 / 分母。分母は 0 以外の整数。",
      "type": "object",
      "required": ["numerator", "denominator"],
      "additionalProperties": false,
      "properties": {
        "numerator": {"type": "integer"},
        "denominator": {
          "oneOf": [
            {"type": "integer", "maximum": -1},
            {"type": "integer", "minimum": 1}
          ]
        }
      }
    },
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": {"$ref": "#/$defs/numericValue"},
        "y": {"$ref": "#/$defs/numericValue"}
      }
    },
    "region": {
      "description": "頂点は多角形の辺に沿って並べる。openEdges を省略した辺は閉じる。開いた辺に乗る点は、同じ点が別の閉じた辺の端点でもこの領域に含めない。",
      "type": "object",
      "required": ["regionId", "position", "vertices"],
      "additionalProperties": false,
      "properties": {
        "regionId": {"type": "string", "minLength": 1},
        "position": {"type": "integer", "minimum": 1, "maximum": 9},
        "vertices": {
          "type": "array",
          "minItems": 3,
          "items": {"$ref": "#/$defs/point"}
        },
        "openEdges": {
          "description": "開いた辺の 0 始まりの番号。辺 i は vertices[i] から vertices[(i+1) mod 頂点数] まで。列挙しない辺は閉じる。",
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        }
      }
    },
    "directionSector": {
      "type": "object",
      "required": ["directionId", "startAngle", "endAngle"],
      "additionalProperties": false,
      "properties": {
        "directionId": {"type": "string", "minLength": 1},
        "startAngle": {"$ref": "#/$defs/numericValue"},
        "endAngle": {"$ref": "#/$defs/numericValue"}
      }
    }
  }
}
