{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pitchlog.local/contracts/state-transition/state_transition_contract_schema_v1.json",
  "title": "Pitchlog state transition contract schema v1",
  "version": "state_transition_contract_schema_v1",
  "x-pitchlog-stage1-normalization": {
    "caseSchemaRef": "#/$defs/normalizedCase",
    "currentCasesSchemaRef": "#/$defs/derivedCase",
    "casesActivationStep": 90,
    "ruleCatalog": [
      {
        "ruleId": "identity",
        "meaning": "raw の JSON 値を変更せず normalized として渡す",
        "semanticOrigin": "step-89-local-definition",
        "basisRefs": [
          "docs/features/appendix-e-golden-vectors/design.md#10",
          "docs/features/appendix-e-golden-vectors/plan.md#step-89"
        ]
      }
    ],
    "ruleGranularityReason": "ステップ89は3点の構造と欠落検知までを扱うため、意味を確定できる identity だけを宣言する。値が変わる規則は既存 case へ反映するステップ90で具体化する",
    "claimBoundary": {
      "subject": "step-89-schema-and-examples",
      "guaranteed": "normalizedCase 定義による3点の存在と規則識別子の語彙制限",
      "notGuaranteed": [
        "existing-cases-have-normalization-triple",
        "normalization-rule-semantic-correctness",
        "normalizer-execution-or-comparison",
        "noncanonical-raw-rejection",
        "input-coordinate-to-raw-or-normalized-mapping"
      ]
    }
  },
  "x-pitchlog-reference-constraints": {
    "rowIdentity": {
      "collectionAnnotation": "x-pitchlog-normative-row-layer",
      "coordinateFieldsAnnotation": "x-pitchlog-input-coordinate-fields",
      "canonicalization": "RFC8785",
      "maximumOccurrences": 1
    },
    "caseResolution": {
      "collection": "cases",
      "referenceField": "rowRef",
      "layerField": "layer",
      "coordinateField": "coordinate",
      "requiredMatchCount": 1
    },
    "vocabularyResolution": {
      "collectionAnnotation": "x-pitchlog-vocabulary-reference-layer",
      "referenceField": "resultId",
      "manifestPath": "contracts/vocabulary/vocabulary_manifest_v1.json",
      "requiredMatchCount": 1,
      "failWhenManifestUnavailable": true
    },
    "predicateAxisResolution": {
      "rowCollections": [
        "matrixRows",
        "operationRows",
        "undoRows"
      ],
      "predicateField": "precondition",
      "axisIdField": "axisId",
      "descriptorCollections": [
        "stateTransitionAxes",
        "gameEndAxes"
      ],
      "descriptorAxisIdField": "axisId",
      "descriptorClassificationField": "classification",
      "descriptorValueFieldsByClassification": {
        "finite-enumerable": "values",
        "boundary-partition": "boundaryValues"
      },
      "requiredMatchCount": 1
    }
  },
  "x-pitchlog-vocabulary-axis-coverage": {
    "manifestPath": "contracts/vocabulary/vocabulary_manifest_v1.json",
    "vocabularyId": "input_vocabulary",
    "axisCollection": "axes",
    "axisIdField": "axisId",
    "entriesCollection": "entries",
    "entryIdField": "id",
    "rowCollection": "matrixRows",
    "rowDiscriminatorField": "eventKind",
    "rowVocabularyIdField": "resultId",
    "requiredRelationship": "exact-set",
    "requiredAxisIds": [
      "batting-result",
      "secondary-result",
      "strategy-category",
      "pitcher-pickoff-destination",
      "catcher-pickoff-destination"
    ],
    "coverageSets": [
      {
        "axisIds": [
          "batting-result"
        ],
        "rowDiscriminatorValue": "batting-result"
      },
      {
        "axisIds": [
          "secondary-result"
        ],
        "rowDiscriminatorValue": "secondary-result"
      },
      {
        "axisIds": [
          "strategy-category",
          "pitcher-pickoff-destination",
          "catcher-pickoff-destination"
        ],
        "rowDiscriminatorValue": "runner-event"
      }
    ]
  },
  "x-pitchlog-operation-row-constraints": {
    "sourceDecisionId": "adr:D-8",
    "clauseByOperationKind": {
      "substitution": "FR-011",
      "tiebreak-start": "FR-009",
      "game-end-declaration": "FR-010",
      "adhoc-registration": "FR-015",
      "state-correction": "FR-040"
    },
    "conditionalOperationKinds": [
      {
        "value": "state-correction",
        "whenClauseId": "req:FR-040",
        "whenState": "adopted"
      }
    ],
    "payloadSchemaRequiredKeywords": [
      "type",
      "properties",
      "required",
      "additionalProperties"
    ]
  },
  "x-pitchlog-undo-row-constraints": {
    "sourceDecisionId": "adr:D-8",
    "sourceClauseId": "req:FR-006",
    "preconditionAxisIdPrefix": "history.",
    "conditionalTargetKinds": [
      {
        "value": "state-correction",
        "whenClauseId": "req:FR-040",
        "whenState": "adopted"
      }
    ],
    "rules": [
      {
        "constraintId": "XC-09",
        "definitionId": "constraint:XC-09",
        "kind": "liveness-only-at-d-plus-one",
        "depthAxisId": "history.depth",
        "depthLimitValue": "D",
        "scenarioLengthAxisId": "history.scenarioLength",
        "dPlusOneValue": "D+1",
        "livenessMode": "liveness-only",
        "defaultMode": "full-equality",
        "undecidableAction": "fail"
      }
    ]
  },
  "x-pitchlog-must-operation-coverage": {
    "sourceDecisionId": "adr:D-6",
    "sourceClauseId": "req:4.0-4",
    "mappingCollection": "mappings",
    "operationTypeField": "operationType",
    "rowReferencesField": "rowRefs",
    "rowLayerField": "layer",
    "rowCoordinateField": "coordinate",
    "rowLayerAnnotation": "x-pitchlog-normative-row-layer",
    "coordinateFieldsAnnotation": "x-pitchlog-input-coordinate-fields",
    "requiredOperations": [
      {
        "operationType": "per-pitch-input",
        "rowLayer": "matrixRows",
        "discriminatorField": "eventKind",
        "exactDiscriminatorValues": [
          "batting-result",
          "secondary-result",
          "runner-event"
        ]
      },
      {
        "operationType": "undo",
        "rowLayer": "undoRows"
      },
      {
        "operationType": "substitution",
        "rowLayer": "operationRows",
        "discriminatorField": "operationKind",
        "exactDiscriminatorValues": [
          "substitution"
        ]
      },
      {
        "operationType": "tiebreak-start",
        "rowLayer": "operationRows",
        "discriminatorField": "operationKind",
        "exactDiscriminatorValues": [
          "tiebreak-start"
        ]
      },
      {
        "operationType": "game-end-declaration",
        "rowLayer": "operationRows",
        "discriminatorField": "operationKind",
        "exactDiscriminatorValues": [
          "game-end-declaration"
        ]
      },
      {
        "operationType": "adhoc-registration",
        "rowLayer": "operationRows",
        "discriminatorField": "operationKind",
        "exactDiscriminatorValues": [
          "adhoc-registration"
        ]
      }
    ],
    "conditionalOperations": [
      {
        "operationType": "state-correction",
        "rowLayer": "operationRows",
        "discriminatorField": "operationKind",
        "exactDiscriminatorValues": [
          "state-correction"
        ],
        "whenClauseId": "req:FR-040",
        "whenState": "adopted"
      }
    ],
    "checks": {
      "referenceExistence": {
        "requiredMatchCount": 1
      },
      "layerAndDiscriminatorConsistency": {
        "required": true
      },
      "duplicateProhibition": {
        "operationTypeMaximumOccurrences": 1,
        "rowReferenceMaximumOccurrences": 1
      },
      "unassignedRows": {
        "maximumOccurrences": 1
      },
      "perPitchSubtypeExactSet": {
        "operationType": "per-pitch-input"
      }
    },
    "manifestOmissionResolution": {
      "manifestPath": "backend/domain/manifest.json",
      "collection": "vectors",
      "calculationField": "calculation",
      "calculationValue": "state-transition",
      "exclusionsField": "excludedOptionalOperations",
      "operationTypeField": "operationType",
      "clauseIdField": "clauseId",
      "adoptionStateField": "adoptionState",
      "notAdoptedValue": "not-adopted",
      "requiredMatchCount": 1,
      "failWhenManifestUnavailable": true
    }
  },
  "x-pitchlog-matrix-cross-constraints": {
    "sourceClauseId": "req:E-1",
    "rowCollection": "matrixRows",
    "excludedConstraintIds": [
      "XC-09"
    ],
    "runnerPresence": {
      "axisId": "state.runners",
      "undecidableAction": "fail",
      "baseByRunnerNumber": {
        "1": "first",
        "2": "second",
        "3": "third"
      },
      "presentValuesByBase": {
        "first": [
          "first",
          "first-second",
          "first-third",
          "loaded"
        ],
        "second": [
          "second",
          "first-second",
          "second-third",
          "loaded"
        ],
        "third": [
          "third",
          "first-third",
          "second-third",
          "loaded"
        ]
      }
    },
    "rules": [
      {
        "constraintId": "XC-01",
        "kind": "event-requires-batter-destination",
        "eventKind": "runner-event",
        "requiredDestinationKind": "not-applicable"
      },
      {
        "constraintId": "XC-02",
        "kind": "absent-runner-requires-modality",
        "requiredModality": "not-applicable"
      },
      {
        "constraintId": "XC-03",
        "kind": "advance-modality-destination-equivalence",
        "nullDestinationModalities": [
          "hold",
          "not-applicable"
        ],
        "nonNullDestinationModalities": [
          "forced",
          "optional"
        ]
      },
      {
        "constraintId": "XC-04",
        "kind": "out-count-target-cardinality-and-uniqueness",
        "targetCanonicalization": "RFC8785"
      },
      {
        "constraintId": "XC-05",
        "kind": "event-requires-count-effect",
        "eventKind": "runner-event",
        "requiredEffectKind": "unchanged"
      },
      {
        "constraintId": "XC-06",
        "kind": "plate-appearance-result-count-equivalence",
        "excludedEventKinds": [
          "runner-event"
        ],
        "endedDestinationKinds": [
          "reach",
          "out",
          "score"
        ],
        "continuingDestinationKinds": [
          "continue",
          "not-applicable"
        ],
        "requiredResetEffectKind": "reset",
        "allowedDestinationKindsByEvent": {
          "batting-result": [
            "continue",
            "reach",
            "out",
            "score"
          ],
          "secondary-result": [
            "continue",
            "reach",
            "out",
            "not-applicable"
          ]
        }
      },
      {
        "constraintId": "XC-07",
        "kind": "event-plate-not-applicable-equivalence",
        "eventKind": "runner-event",
        "notApplicableValue": "not-applicable"
      },
      {
        "constraintId": "XC-08",
        "kind": "runner-origin-destination-allowlist",
        "allowedDestinationsByBase": {
          "first": [
            2,
            3,
            4
          ],
          "second": [
            3,
            4
          ],
          "third": [
            4
          ]
        }
      },
      {
        "constraintId": "XC-10",
        "kind": "batter-out-target-equivalence",
        "batterOutDestinationKind": "out",
        "batterTarget": "batter"
      },
      {
        "constraintId": "XC-11",
        "kind": "maximum-prior-outs-plus-effect",
        "outsAxisId": "state.outs",
        "maximumPostPlayOuts": 3,
        "undecidableAction": "fail"
      },
      {
        "constraintId": "XC-12",
        "kind": "absent-runner-prohibits-out-target"
      },
      {
        "constraintId": "XC-13",
        "kind": "deferred-derived-stat-flags-principle",
        "principleId": "principle:stat-flags-derived-not-arbitrary",
        "enforcement": "deferred-stage-2",
        "machineGuarantee": "not-established",
        "stage2DeclarationPointer": "/stage2ExternalConstraints",
        "deferredConstraintClasses": [
          "stat-flag-derivation-rules",
          "third-out-type-observation-input",
          "official-scorer-judgment-inputs"
        ],
        "requiredArtifacts": [
          "stat-flag-derivation-table",
          "third-out-type-input-contract",
          "official-scorer-judgment-input-contract",
          "negative-fixtures"
        ]
      }
    ]
  },
  "x-pitchlog-deferred-row-requirements": {
    "deferments": [
      {
        "defermentId": "SO-03-dropped-third-strike-outcome",
        "status": "open-stage-2",
        "partitionRuleId": "dropped-third-strike-outcome",
        "requiredPartitions": [
          "safe",
          "out"
        ],
        "materializedPartitions": [
          "safe"
        ],
        "missingPartitions": [
          "out"
        ],
        "requiredRowCount": 2,
        "materializedRowCount": 1,
        "sourceClauseIds": [
          "req:SO-03",
          "req:XC-13"
        ],
        "gapId": "GAP-08",
        "stage2DeclarationAsset": "contracts/state-transition/input_axes_descriptor_v1.json",
        "stage2DeclarationPointer": "/stage2ExternalConstraints",
        "deferredConstraintClass": "third-out-type-observation-input",
        "requiredArtifact": "third-out-type-input-contract",
        "reason": "SO-03が要求するセーフ／アウト2行の入力座標を分ける観測入力が段階2であるため、セーフ側1行だけを規範行へ置き、アウト側を充足済みとは扱わない"
      }
    ]
  },
  "x-pitchlog-provenance-policy": {
    "recordLocation": "contract-top-level",
    "recordField": "provenance",
    "sourceKinds": {
      "requirements": {
        "priority": 1,
        "verificationMode": "repository-clause-id-existence",
        "sourcePath": "docs/requirements/requirements-pitchlog-2026-07-22.md",
        "sourceIdNamespace": "req",
        "machineCapability": "identifier-existence"
      },
      "official-baseball-rules": {
        "priority": 2,
        "verificationMode": "identifier-format-only",
        "sourceIdPattern": "^obr:[1-9][0-9]*\\.[0-9]{2}(?:\\([a-z0-9]+\\))*$",
        "machineCapability": "identifier-format-only",
        "notMechanicallyVerified": [
          "rule-number-existence",
          "rule-content"
        ]
      },
      "legacy-vocab-mirror": {
        "priority": 3,
        "verificationMode": "vocabulary-id-existence-via-manifest",
        "manifestPath": "contracts/vocabulary/vocabulary_manifest_v1.json",
        "machineCapability": "vocabulary-id-existence"
      },
      "legacy-research": {
        "priority": 4,
        "verificationMode": "repository-line-reference-existence",
        "pathRoot": "docs/legacy/research",
        "sourceIdPattern": "^(?P<path>docs/legacy/research/[A-Za-z0-9._/-]+\\.md):(?P<line>[1-9][0-9]*)$",
        "machineCapability": "path-and-line-existence"
      }
    },
    "subjectKinds": {
      "normative-branch-or-state-effect": {
        "sufficientSourceKinds": [
          "requirements",
          "official-baseball-rules"
        ]
      },
      "vocabulary-origin": {
        "sufficientSourceKinds": [
          "requirements",
          "official-baseball-rules",
          "legacy-vocab-mirror"
        ]
      }
    },
    "attestationItems": {
      "direct-source-clause-review": {
        "acceptedResponses": [
          true
        ],
        "humanMeaning": "独立確認者が典拠の条文そのものから確認し、導出物・生成物・他者の要約を根拠にしていない"
      },
      "author-work-exposure": {
        "acceptedResponses": [
          "not-seen-before-source-review",
          "seen-and-recorded"
        ],
        "humanMeaning": "作成者の作業結果を見る前に典拠を読んだか、見た場合はその事実を記録した"
      },
      "source-support-judgment": {
        "acceptedResponses": [
          true
        ],
        "humanMeaning": "典拠が主張を支持すると独立確認者が判断した"
      }
    },
    "assuranceBoundary": {
      "mechanicallyGuaranteed": [
        "source-reference-within-declared-machine-capability",
        "recorded-author-and-independent-verifier-are-different",
        "attestation-record-exact-set-and-accepted-responses"
      ],
      "humanControls": [
        "independent-review-actually-performed",
        "attestations-are-truthful",
        "source-supports-claim",
        "official-rule-number-exists-and-content-is-correct",
        "vocabulary-mirror-version-is-correct",
        "legacy-research-is-suitable-corroboration"
      ],
      "step43Excluded": "approved成果物の別人による条文からの直接レビュー署名はステップ43が所有する"
    }
  },
  "type": "object",
  "required": [
    "schemaVersion",
    "version",
    "calculation",
    "inputAxesDescriptor",
    "provenance",
    "matrixRows",
    "operationRows",
    "undoRows",
    "mustOperationCoverage",
    "requiredSet",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer"
    },
    "version": {
      "type": "string",
      "pattern": "^[a-z]+(?:_[a-z]+)*_v[1-9][0-9]*$"
    },
    "calculation": {
      "type": "string",
      "minLength": 1
    },
    "inputAxesDescriptor": {
      "$ref": "#/$defs/inputAxesDescriptorBinding"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "matrixRows": {
      "x-pitchlog-normative-row-layer": true,
      "x-pitchlog-vocabulary-reference-layer": true,
      "x-pitchlog-input-coordinate-fields": [
        "eventKind",
        "resultId",
        "precondition"
      ],
      "type": "array",
      "items": {
        "$ref": "#/$defs/matrixRow"
      }
    },
    "operationRows": {
      "x-pitchlog-normative-row-layer": true,
      "x-pitchlog-input-coordinate-fields": [
        "operationKind",
        "payloadShape",
        "precondition"
      ],
      "type": "array",
      "items": {
        "$ref": "#/$defs/operationRow"
      }
    },
    "undoRows": {
      "x-pitchlog-normative-row-layer": true,
      "x-pitchlog-input-coordinate-fields": [
        "targetKind",
        "precondition"
      ],
      "type": "array",
      "items": {
        "$ref": "#/$defs/undoRow"
      }
    },
    "mustOperationCoverage": {
      "type": "object",
      "required": [
        "mappings"
      ],
      "additionalProperties": false,
      "properties": {
        "mappings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/mustOperationMapping"
          }
        }
      }
    },
    "requiredSet": {
      "type": "object",
      "additionalProperties": true
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/derivedCase"
      }
    }
  },
  "$defs": {
    "inputAxesDescriptorBinding": {
      "type": "object",
      "required": [
        "descriptorId",
        "version",
        "digest"
      ],
      "additionalProperties": false,
      "properties": {
        "descriptorId": {
          "const": "pitchlog.input-axes"
        },
        "version": {
          "const": "input_axes_descriptor_v1"
        },
        "digest": {
          "const": "sha256:9758159e76c974df31a09fb8d3db7c0f25c46b8aa4ee3e1b28db25ac800ccce9"
        }
      }
    },
    "literal": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        }
      ]
    },
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "enum": [
                "and",
                "or"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/predicate"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "not"
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/predicate"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "axisId",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "enum": [
                "eq",
                "gte",
                "lte"
              ]
            },
            "axisId": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "$ref": "#/$defs/literal"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "axisId",
            "values"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "in"
            },
            "axisId": {
              "type": "string",
              "minLength": 1
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/literal"
              }
            }
          }
        }
      ]
    },
    "eventKind": {
      "enum": [
        "batting-result",
        "secondary-result",
        "runner-event"
      ]
    },
    "strikeEffect": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "delta"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "reset"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unchanged"
            }
          }
        }
      ]
    },
    "ballEffect": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "delta"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "reset"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
