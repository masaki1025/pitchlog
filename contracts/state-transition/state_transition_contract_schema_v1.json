{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pitchlog.local/contracts/state-transition/state_transition_contract_schema_v1.json",
  "title": "Pitchlog state transition contract schema v1",
  "version": "state_transition_contract_schema_v1",
  "x-pitchlog-reference-constraints": {
    "rowIdentity": {
      "collectionAnnotation": "x-pitchlog-normative-row-layer",
      "coordinateFieldsAnnotation": "x-pitchlog-input-coordinate-fields",
      "canonicalization": "RFC8785",
      "maximumOccurrences": 1
    },
    "caseResolution": {
      "collection": "cases",
      "referenceField": "rowRef",
      "layerField": "layer",
      "coordinateField": "coordinate",
      "requiredMatchCount": 1
    },
    "vocabularyResolution": {
      "collectionAnnotation": "x-pitchlog-vocabulary-reference-layer",
      "referenceField": "resultId",
      "manifestPath": "contracts/vocabulary/vocabulary_manifest_v1.json",
      "requiredMatchCount": 1,
      "failWhenManifestUnavailable": true
    },
    "predicateAxisResolution": {
      "rowCollections": [
        "matrixRows",
        "operationRows",
        "undoRows"
      ],
      "predicateField": "precondition",
      "axisIdField": "axisId",
      "descriptorCollections": [
        "stateTransitionAxes",
        "gameEndAxes"
      ],
      "descriptorAxisIdField": "axisId",
      "descriptorClassificationField": "classification",
      "descriptorValueFieldsByClassification": {
        "finite-enumerable": "values",
        "boundary-partition": "boundaryValues"
      },
      "requiredMatchCount": 1
    }
  },
  "x-pitchlog-operation-row-constraints": {
    "sourceDecisionId": "adr:D-8",
    "clauseByOperationKind": {
      "substitution": "FR-011",
      "tiebreak-start": "FR-009",
      "game-end-declaration": "FR-010",
      "adhoc-registration": "FR-015",
      "state-correction": "FR-040"
    },
    "conditionalOperationKinds": [
      {
        "value": "state-correction",
        "whenClauseId": "req:FR-040",
        "whenState": "adopted"
      }
    ],
    "payloadSchemaRequiredKeywords": [
      "type",
      "properties",
      "required",
      "additionalProperties"
    ]
  },
  "x-pitchlog-undo-row-constraints": {
    "sourceDecisionId": "adr:D-8",
    "sourceClauseId": "req:FR-006",
    "preconditionAxisIdPrefix": "history.",
    "conditionalTargetKinds": [
      {
        "value": "state-correction",
        "whenClauseId": "req:FR-040",
        "whenState": "adopted"
      }
    ],
    "rules": [
      {
        "constraintId": "XC-09",
        "definitionId": "constraint:XC-09",
        "kind": "liveness-only-at-d-plus-one",
        "depthAxisId": "history.depth",
        "depthLimitValue": "D",
        "scenarioLengthAxisId": "history.scenarioLength",
        "dPlusOneValue": "D+1",
        "livenessMode": "liveness-only",
        "defaultMode": "full-equality",
        "undecidableAction": "fail"
      }
    ]
  },
  "x-pitchlog-must-operation-coverage": {
    "sourceDecisionId": "adr:D-6",
    "sourceClauseId": "req:4.0-4",
    "mappingCollection": "mappings",
    "operationTypeField": "operationType",
    "rowReferencesField": "rowRefs",
    "rowLayerField": "layer",
    "rowCoordinateField": "coordinate",
    "rowLayerAnnotation": "x-pitchlog-normative-row-layer",
    "coordinateFieldsAnnotation": "x-pitchlog-input-coordinate-fields",
    "requiredOperations": [
      {
        "operationType": "per-pitch-input",
        "rowLayer": "matrixRows",
        "discriminatorField": "eventKind",
        "exactDiscriminatorValues": [
          "batting-result",
          "secondary-result",
          "runner-event"
        ]
      },
      {
        "operationType": "undo",
        "rowLayer": "undoRows"
      },
      {
        "operationType": "substitution",
        "rowLayer": "operationRows",
        "discriminatorField": "operationKind",
        "exactDiscriminatorValues": [
          "substitution"
        ]
      },
      {
        "operationType": "tiebreak-start",
        "rowLayer": "operationRows",
        "discriminatorField": "operationKind",
        "exactDiscriminatorValues": [
          "tiebreak-start"
        ]
      },
      {
        "operationType": "game-end-declaration",
        "rowLayer": "operationRows",
        "discriminatorField": "operationKind",
        "exactDiscriminatorValues": [
          "game-end-declaration"
        ]
      },
      {
        "operationType": "adhoc-registration",
        "rowLayer": "operationRows",
        "discriminatorField": "operationKind",
        "exactDiscriminatorValues": [
          "adhoc-registration"
        ]
      }
    ],
    "conditionalOperations": [
      {
        "operationType": "state-correction",
        "rowLayer": "operationRows",
        "discriminatorField": "operationKind",
        "exactDiscriminatorValues": [
          "state-correction"
        ],
        "whenClauseId": "req:FR-040",
        "whenState": "adopted"
      }
    ],
    "checks": {
      "referenceExistence": {
        "requiredMatchCount": 1
      },
      "layerAndDiscriminatorConsistency": {
        "required": true
      },
      "duplicateProhibition": {
        "operationTypeMaximumOccurrences": 1,
        "rowReferenceMaximumOccurrences": 1
      },
      "unassignedRows": {
        "maximumOccurrences": 1
      },
      "perPitchSubtypeExactSet": {
        "operationType": "per-pitch-input"
      }
    },
    "manifestOmissionResolution": {
      "manifestPath": "backend/domain/manifest.json",
      "collection": "vectors",
      "calculationField": "calculation",
      "calculationValue": "state-transition",
      "exclusionsField": "excludedOptionalOperations",
      "operationTypeField": "operationType",
      "clauseIdField": "clauseId",
      "adoptionStateField": "adoptionState",
      "notAdoptedValue": "not-adopted",
      "requiredMatchCount": 1,
      "failWhenManifestUnavailable": true
    }
  },
  "x-pitchlog-matrix-cross-constraints": {
    "sourceClauseId": "req:E-1",
    "rowCollection": "matrixRows",
    "excludedConstraintIds": [
      "XC-09"
    ],
    "runnerPresence": {
      "axisId": "state.runners",
      "undecidableAction": "fail",
      "baseByRunnerNumber": {
        "1": "first",
        "2": "second",
        "3": "third"
      },
      "presentValuesByBase": {
        "first": [
          "first",
          "first-second",
          "first-third",
          "loaded"
        ],
        "second": [
          "second",
          "first-second",
          "second-third",
          "loaded"
        ],
        "third": [
          "third",
          "first-third",
          "second-third",
          "loaded"
        ]
      }
    },
    "rules": [
      {
        "constraintId": "XC-01",
        "kind": "event-requires-batter-destination",
        "eventKind": "runner-event",
        "requiredDestinationKind": "not-applicable"
      },
      {
        "constraintId": "XC-02",
        "kind": "absent-runner-requires-modality",
        "requiredModality": "not-applicable"
      },
      {
        "constraintId": "XC-03",
        "kind": "advance-modality-destination-equivalence",
        "nullDestinationModalities": [
          "hold",
          "not-applicable"
        ],
        "nonNullDestinationModalities": [
          "forced",
          "optional"
        ]
      },
      {
        "constraintId": "XC-04",
        "kind": "out-count-target-cardinality-and-uniqueness",
        "targetCanonicalization": "RFC8785"
      },
      {
        "constraintId": "XC-05",
        "kind": "event-requires-count-effect",
        "eventKind": "runner-event",
        "requiredEffectKind": "unchanged"
      },
      {
        "constraintId": "XC-06",
        "kind": "plate-appearance-result-count-equivalence",
        "excludedEventKinds": [
          "runner-event"
        ],
        "endedDestinationKinds": [
          "reach",
          "out",
          "score"
        ],
        "continuingDestinationKinds": [
          "continue",
          "not-applicable"
        ],
        "requiredResetEffectKind": "reset",
        "allowedDestinationKindsByEvent": {
          "batting-result": [
            "continue",
            "reach",
            "out",
            "score"
          ],
          "secondary-result": [
            "continue",
            "reach",
            "out",
            "not-applicable"
          ]
        }
      },
      {
        "constraintId": "XC-07",
        "kind": "event-plate-not-applicable-equivalence",
        "eventKind": "runner-event",
        "notApplicableValue": "not-applicable"
      },
      {
        "constraintId": "XC-08",
        "kind": "runner-origin-destination-allowlist",
        "allowedDestinationsByBase": {
          "first": [
            2,
            3,
            4
          ],
          "second": [
            3,
            4
          ],
          "third": [
            4
          ]
        }
      },
      {
        "constraintId": "XC-10",
        "kind": "batter-out-target-equivalence",
        "batterOutDestinationKind": "out",
        "batterTarget": "batter"
      },
      {
        "constraintId": "XC-11",
        "kind": "maximum-prior-outs-plus-effect",
        "outsAxisId": "state.outs",
        "maximumPostPlayOuts": 3,
        "undecidableAction": "fail"
      },
      {
        "constraintId": "XC-12",
        "kind": "absent-runner-prohibits-out-target"
      },
      {
        "constraintId": "XC-13",
        "kind": "deferred-derived-stat-flags-principle",
        "principleId": "principle:stat-flags-derived-not-arbitrary",
        "enforcement": "deferred-stage-2",
        "machineGuarantee": "not-established",
        "stage2DeclarationPointer": "/stage2ExternalConstraints",
        "deferredConstraintClasses": [
          "stat-flag-derivation-rules",
          "third-out-type-observation-input",
          "official-scorer-judgment-inputs"
        ],
        "requiredArtifacts": [
          "stat-flag-derivation-table",
          "third-out-type-input-contract",
          "official-scorer-judgment-input-contract",
          "negative-fixtures"
        ]
      }
    ]
  },
  "type": "object",
  "required": [
    "schemaVersion",
    "version",
    "calculation",
    "inputAxesDescriptor",
    "matrixRows",
    "operationRows",
    "undoRows",
    "mustOperationCoverage",
    "requiredSet",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer"
    },
    "version": {
      "type": "string",
      "pattern": "^[a-z]+(?:_[a-z]+)*_v[1-9][0-9]*$"
    },
    "calculation": {
      "type": "string",
      "minLength": 1
    },
    "inputAxesDescriptor": {
      "$ref": "#/$defs/inputAxesDescriptorBinding"
    },
    "matrixRows": {
      "x-pitchlog-normative-row-layer": true,
      "x-pitchlog-vocabulary-reference-layer": true,
      "x-pitchlog-input-coordinate-fields": [
        "eventKind",
        "resultId",
        "precondition"
      ],
      "type": "array",
      "items": {
        "$ref": "#/$defs/matrixRow"
      }
    },
    "operationRows": {
      "x-pitchlog-normative-row-layer": true,
      "x-pitchlog-input-coordinate-fields": [
        "operationKind",
        "payloadShape",
        "precondition"
      ],
      "type": "array",
      "items": {
        "$ref": "#/$defs/operationRow"
      }
    },
    "undoRows": {
      "x-pitchlog-normative-row-layer": true,
      "x-pitchlog-input-coordinate-fields": [
        "targetKind",
        "precondition"
      ],
      "type": "array",
      "items": {
        "$ref": "#/$defs/undoRow"
      }
    },
    "mustOperationCoverage": {
      "type": "object",
      "required": [
        "mappings"
      ],
      "additionalProperties": false,
      "properties": {
        "mappings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/mustOperationMapping"
          }
        }
      }
    },
    "requiredSet": {
      "type": "object",
      "additionalProperties": true
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/derivedCase"
      }
    }
  },
  "$defs": {
    "inputAxesDescriptorBinding": {
      "type": "object",
      "required": [
        "descriptorId",
        "version",
        "digest"
      ],
      "additionalProperties": false,
      "properties": {
        "descriptorId": {
          "const": "pitchlog.input-axes"
        },
        "version": {
          "const": "input_axes_descriptor_v1"
        },
        "digest": {
          "const": "sha256:feb21c40e4f6904394202e35aec96f8031b8ea4ccd5172072c60300bb9d390ac"
        }
      }
    },
    "literal": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        }
      ]
    },
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "enum": [
                "and",
                "or"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/predicate"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "not"
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/predicate"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "axisId",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "enum": [
                "eq",
                "gte",
                "lte"
              ]
            },
            "axisId": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "$ref": "#/$defs/literal"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "axisId",
            "values"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "in"
            },
            "axisId": {
              "type": "string",
              "minLength": 1
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/literal"
              }
            }
          }
        }
      ]
    },
    "eventKind": {
      "enum": [
        "batting-result",
        "secondary-result",
        "runner-event"
      ]
    },
    "strikeEffect": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "delta"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "reset"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unchanged"
            }
          }
        }
      ]
    },
    "ballEffect": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "delta"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "reset"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unchanged"
            }
          }
        }
      ]
    },
    "countEffect": {
      "type": "object",
      "required": [
        "strikes",
        "balls"
      ],
      "additionalProperties": false,
      "properties": {
        "strikes": {
          "$ref": "#/$defs/strikeEffect"
        },
        "balls": {
          "$ref": "#/$defs/ballEffect"
        }
      }
    },
    "plateAppearanceEnded": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "const": "not-applicable"
        }
      ]
    },
    "batterDestination": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "continue",
                "out",
                "score",
                "not-applicable"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "base"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "reach"
            },
            "base": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            }
          }
        }
      ]
    },
    "advanceDestination": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        {
          "type": "null"
        }
      ]
    },
    "advance": {
      "type": "object",
      "required": [
        "modality",
        "destination"
      ],
      "additionalProperties": false,
      "properties": {
        "modality": {
          "enum": [
            "forced",
            "optional",
            "hold",
            "not-applicable"
          ]
        },
        "destination": {
          "$ref": "#/$defs/advanceDestination"
        }
      }
    },
    "runnerDefaultAdvance": {
      "type": "object",
      "required": [
        "first",
        "second",
        "third"
      ],
      "additionalProperties": false,
      "properties": {
        "first": {
          "$ref": "#/$defs/advance"
        },
        "second": {
          "$ref": "#/$defs/advance"
        },
        "third": {
          "$ref": "#/$defs/advance"
        }
      }
    },
    "outTarget": {
      "oneOf": [
        {
          "const": "batter"
        },
        {
          "type": "object",
          "required": [
            "runner"
          ],
          "additionalProperties": false,
          "properties": {
            "runner": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            }
          }
        }
      ]
    },
    "outEffect": {
      "type": "object",
      "required": [
        "count",
        "targets"
      ],
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outTarget"
          }
        }
      }
    },
    "statFlags": {
      "type": "object",
      "required": [
        "投球回算入アウト",
        "投球数",
        "奪三振",
        "与四球",
        "与死球",
        "被安打",
        "被本塁打",
        "失点",
        "失策",
        "打席",
        "打数",
        "安打",
        "本塁打",
        "塁打",
        "犠打",
        "犠飛",
        "四球",
        "死球",
        "三振",
        "打撃妨害出塁",
        "走塁妨害出塁",
        "得点",
        "打点"
      ],
      "additionalProperties": false,
      "properties": {
        "投球回算入アウト": {"type": "boolean"},
        "投球数": {"type": "boolean"},
        "奪三振": {"type": "boolean"},
        "与四球": {"type": "boolean"},
        "与死球": {"type": "boolean"},
        "被安打": {"type": "boolean"},
        "被本塁打": {"type": "boolean"},
        "失点": {"type": "boolean"},
        "失策": {"type": "boolean"},
        "打席": {"type": "boolean"},
        "打数": {"type": "boolean"},
        "安打": {"type": "boolean"},
        "本塁打": {"type": "boolean"},
        "塁打": {"type": "boolean"},
        "犠打": {"type": "boolean"},
        "犠飛": {"type": "boolean"},
        "四球": {"type": "boolean"},
        "死球": {"type": "boolean"},
        "三振": {"type": "boolean"},
        "打撃妨害出塁": {"type": "boolean"},
        "走塁妨害出塁": {"type": "boolean"},
        "得点": {"type": "boolean"},
        "打点": {"type": "boolean"}
      }
    },
    "matrixRow": {
      "type": "object",
      "required": [
        "eventKind",
        "resultId",
        "precondition",
        "countEffect",
        "plateAppearanceEnded",
        "batterDestination",
        "runnerDefaultAdvance",
        "outEffect",
        "statFlags",
        "remarks"
      ],
      "additionalProperties": false,
      "properties": {
        "eventKind": {
          "$ref": "#/$defs/eventKind"
        },
        "resultId": {
          "type": "string"
        },
        "precondition": {
          "$ref": "#/$defs/predicate"
        },
        "countEffect": {
          "$ref": "#/$defs/countEffect"
        },
        "plateAppearanceEnded": {
          "$ref": "#/$defs/plateAppearanceEnded"
        },
        "batterDestination": {
          "$ref": "#/$defs/batterDestination"
        },
        "runnerDefaultAdvance": {
          "$ref": "#/$defs/runnerDefaultAdvance"
        },
        "outEffect": {
          "$ref": "#/$defs/outEffect"
        },
        "statFlags": {
          "$ref": "#/$defs/statFlags"
        },
        "remarks": {
          "type": "string"
        }
      }
    },
    "operationKind": {
      "enum": [
        "substitution",
        "tiebreak-start",
        "game-end-declaration",
        "adhoc-registration",
        "state-correction"
      ],
      "x-pitchlog-conditional-values": [
        {
          "value": "state-correction",
          "whenClauseId": "req:FR-040",
          "whenState": "adopted"
        }
      ]
    },
    "operationPayloadShape": {
      "type": "object",
      "required": [
        "type",
        "properties",
        "required",
        "additionalProperties"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object"
        },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
