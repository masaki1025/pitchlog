{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pitchlog.local/contracts/state-transition/input_axes_descriptor_schema_v1.json",
  "title": "Pitchlog input axes descriptor v1",
  "version": "input_axes_descriptor_schema_v1",
  "type": "object",
  "required": [
    "descriptorId",
    "version",
    "digest",
    "digestSpec",
    "freezeBaseline",
    "stage2ExternalConstraints",
    "stateTransitionAxes",
    "gameEndAxes",
    "gameEndCombinationRules",
    "nonCoverageFields",
    "projectionRules"
  ],
  "additionalProperties": false,
  "properties": {
    "descriptorId": {
      "type": "string",
      "const": "pitchlog.input-axes"
    },
    "version": {
      "type": "string",
      "const": "input_axes_descriptor_v1"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "digestSpec": {
      "$ref": "#/$defs/digestSpec"
    },
    "freezeBaseline": {
      "$ref": "#/$defs/freezeBaseline"
    },
    "stage2ExternalConstraints": {
      "$ref": "#/$defs/stage2ExternalConstraints"
    },
    "stateTransitionAxes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/axis"
      }
    },
    "gameEndAxes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/axis"
      }
    },
    "gameEndCombinationRules": {
      "$ref": "#/$defs/gameEndCombinationRules"
    },
    "nonCoverageFields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonCoverageField"
      }
    },
    "projectionRules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/projectionRule"
      }
    }
  },
  "$defs": {
    "freezeBaseline": {
      "type": "object",
      "required": [
        "schemaVersion",
        "series",
        "acceptance",
        "identitySpec",
        "criteria",
        "history"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "series": {
          "type": "string",
          "minLength": 1
        },
        "acceptance": {
          "type": "object"
        },
        "identitySpec": {
          "type": "object"
        },
        "criteria": {
          "type": "object",
          "minProperties": 1
        },
        "history": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "digestSpec": {
      "type": "object",
      "required": [
        "excludedJsonPointers",
        "canonicalization",
        "encoding",
        "hashAlgorithm",
        "stage1ExternalReferences",
        "stage2DigestRule"
      ],
      "additionalProperties": false,
      "properties": {
        "excludedJsonPointers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "const": "/digest"
          }
        },
        "canonicalization": {
          "type": "string",
          "const": "RFC8785"
        },
        "encoding": {
          "type": "string",
          "const": "UTF-8"
        },
        "hashAlgorithm": {
          "type": "string",
          "const": "SHA-256"
        },
        "stage1ExternalReferences": {
          "type": "string",
          "const": "forbidden"
        },
        "stage2DigestRule": {
          "type": "string",
          "const": "json-pointer-plus-content-hash-transitive"
        }
      }
    },
    "stage2ExternalConstraints": {
      "type": "object",
      "required": [
        "status",
        "sourceClauseId",
        "payloadAxisIds",
        "constraintClasses",
        "axisCombinationScope",
        "resolutionStage",
        "requiredArtifacts",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "deferred"
        },
        "sourceClauseId": {
          "$ref": "#/$defs/sourceClauseId"
        },
        "payloadAxisIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/axisId"
          }
        },
        "constraintClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "field-uniqueness",
              "reference-integrity",
              "mutual-exclusion",
              "state-transition-axis-combinations",
              "payload-string-policy-reconciliation",
              "stat-flag-derivation-rules",
              "third-out-type-observation-input",
              "official-scorer-judgment-inputs"
            ]
          }
        },
        "axisCombinationScope": {
          "const": "all-state-transition-axes"
        },
        "resolutionStage": {
          "const": "stage2-vector-and-checker-implementation"
        },
        "requiredArtifacts": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "closed-payload-schemas",
              "state-transition-axis-combination-rules",
              "payload-string-policy-reconciliation-rule",
              "stat-flag-derivation-table",
              "third-out-type-input-contract",
              "official-scorer-judgment-input-contract",
              "negative-fixtures"
            ]
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "descriptorValue": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "finiteEnumerableAxis": {
      "type": "object",
      "required": [
        "axisId",
        "sourceClauseId",
        "classification",
        "values"
      ],
      "additionalProperties": false,
      "properties": {
        "axisId": {
          "$ref": "#/$defs/axisId"
        },
        "sourceClauseId": {
          "$ref": "#/$defs/sourceClauseId"
        },
        "supportingClauseIds": {
          "$ref": "#/$defs/supportingClauseIds"
        },
        "classification": {
          "$ref": "#/$defs/axisClassification",
          "const": "finite-enumerable"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/descriptorValue"
          }
        },
        "conditionalValues": {
          "$ref": "#/$defs/conditionalValues"
        }
      }
    },
    "boundaryPartitionAxis": {
      "type": "object",
      "required": [
        "axisId",
        "sourceClauseId",
        "classification",
        "boundaryValues"
      ],
      "additionalProperties": false,
      "properties": {
        "axisId": {
          "$ref": "#/$defs/axisId"
        },
        "sourceClauseId": {
          "$ref": "#/$defs/sourceClauseId"
        },
        "supportingClauseIds": {
          "$ref": "#/$defs/supportingClauseIds"
        },
        "ruleFieldId": {
          "$ref": "#/$defs/ruleFieldId"
        },
        "classification": {
          "$ref": "#/$defs/axisClassification",
          "const": "boundary-partition"
        },
        "boundaryValues": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/descriptorValue"
          }
        },
        "invalidBoundaryValues": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/descriptorValue"
          }
        },
        "coverageBounds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/coverageBound"
          }
        },
        "conditionalValues": {
          "$ref": "#/$defs/conditionalValues"
        },
        "valueSchema": {
          "$ref": "#/$defs/valueSchema"
        },
        "representationCapability": {
          "$ref": "#/$defs/representationCapability"
        }
      }
    },
    "nonFiniteAxis": {
      "type": "object",
      "required": [
        "axisId",
        "sourceClauseId",
        "classification",
        "nonFiniteReason"
      ],
      "additionalProperties": false,
      "properties": {
        "axisId": {
          "$ref": "#/$defs/axisId"
        },
        "sourceClauseId": {
          "$ref": "#/$defs/sourceClauseId"
        },
        "supportingClauseIds": {
          "$ref": "#/$defs/supportingClauseIds"
        },
        "classification": {
          "$ref": "#/$defs/axisClassification",
          "const": "non-finite"
        },
        "nonFiniteReason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "axis": {
      "oneOf": [
        {
          "$ref": "#/$defs/finiteEnumerableAxis"
        },
        {
          "$ref": "#/$defs/boundaryPartitionAxis"
        },
        {
          "$ref": "#/$defs/nonFiniteAxis"
        }
      ]
    },
    "axisClassification": {
      "type": "string",
      "enum": [
        "finite-enumerable",
        "boundary-partition",
        "non-finite"
      ]
    },
    "axisId": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*(?:[._-][A-Za-z0-9]+)*$"
    },
    "sourceClauseId": {
      "type": "string",
      "pattern": "^(?:req:(?:(?:FR|NFR)-[0-9]+|[0-9]+\\.[0-9]+-[0-9]+|[A-Z]-[0-9]+[a-z]?|(?:COLD|DRAW|XMARK|OUT3|ADV|INT|SO|RBI|XC)-[0-9]+)|adr:D-[0-9]+)$"
    },
    "supportingClauseIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sourceClauseId"
      }
    },
    "ruleFieldId": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*(?:[._-][A-Za-z0-9]+)*$"
    },
    "conditionalValues": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "value",
          "whenClauseId",
          "whenState"
        ],
        "additionalProperties": false,
        "properties": {
          "value": {
            "$ref": "#/$defs/descriptorValue"
          },
          "whenClauseId": {
            "$ref": "#/$defs/sourceClauseId"
          },
          "whenState": {
            "type": "string",
            "const": "adopted"
          }
        }
      }
    },
    "valueSchema": {
      "type": "object",
      "minProperties": 1
    },
    "representationCapability": {
      "type": "object",
      "required": [
        "kind",
        "dimensions",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "tagged-operation-payload",
            "runner-keyed-event-payload",
            "runner-keyed-advance-override",
            "tagged-targeted-ruling",
            "runner-keyed-observation",
            "official-scoring-payload"
          ]
        },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "variantTags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "coverageBound": {
      "type": "object",
      "required": [
        "dimension",
        "minimum",
        "maximum"
      ],
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$"
        },
        "minimum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maximum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "gameEndCombinationRules": {
      "type": "object",
      "required": [
        "sourceClauseId",
        "ruleFieldCombination",
        "boundaryValueCombination"
      ],
      "additionalProperties": false,
      "properties": {
        "sourceClauseId": {
          "$ref": "#/$defs/sourceClauseId"
        },
        "ruleFieldCombination": {
          "type": "string",
          "const": "pairwise-all-game-end-axes"
        },
        "boundaryValueCombination": {
          "type": "string",
          "const": "full-cross-product-with-all-state-and-event-axes"
        }
      }
    },
    "nonCoverageField": {
      "type": "object",
      "required": [
        "fieldId",
        "sourceClauseId",
        "reason",
        "schemaRetention"
      ],
      "additionalProperties": false,
      "properties": {
        "fieldId": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*(?:[._-][A-Za-z0-9]+)*$"
        },
        "sourceClauseId": {
          "$ref": "#/$defs/sourceClauseId"
        },
        "supportingClauseIds": {
          "$ref": "#/$defs/supportingClauseIds"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "schemaRetention": {
          "type": "string",
          "const": "required-by-projection"
        }
      }
    },
    "projectionRule": {
      "type": "object",
      "required": [
        "ruleId",
        "sourceClauseId",
        "sourceKind",
        "targetIds",
        "projectionMode",
        "jsonSchemaKeywords",
        "parityChecks",
        "verificationStage",
        "mismatchAction",
        "undecidableAction",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "ruleId": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*(?:[._-][A-Za-z0-9]+)*$"
        },
        "sourceClauseId": {
          "$ref": "#/$defs/sourceClauseId"
        },
        "sourceKind": {
          "type": "string",
          "enum": [
            "finite-enumerable",
            "boundary-partition",
            "non-finite",
            "non-coverage-field",
            "descriptor-identity"
          ]
        },
        "targetIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*(?:[._-][A-Za-z0-9]+)*$"
          }
        },
        "projectionMode": {
          "type": "string",
          "enum": [
            "exact-enum",
            "boundary-annotations",
            "bounded-boundary-annotations",
            "structured-boundary-annotations",
            "deferred-structured-boundary-annotations",
            "open-domain-with-reason",
            "required-schema-property",
            "descriptor-identity-binding"
          ]
        },
        "jsonSchemaKeywords": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "parityChecks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "axis-id-exact",
              "classification-exact",
              "values-exact-set",
              "boundaries-exact-set",
              "range-exact",
              "non-finite-reason-exact",
              "field-id-exact",
              "reason-exact",
              "schema-retention-exact",
              "descriptor-identity-exact",
              "value-schema-exact",
              "representation-capability-exact",
              "stage2-delegation-exact",
              "conditional-values-exact",
              "no-extra-or-missing-targets"
            ]
          }
        },
        "verificationStage": {
          "type": "string",
          "const": "stage2-descriptorParity"
        },
        "mismatchAction": {
          "type": "string",
          "const": "manifest-registration-denied"
        },
        "undecidableAction": {
          "type": "string",
          "const": "fail"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
