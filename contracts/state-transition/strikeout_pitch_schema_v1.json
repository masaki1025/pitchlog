            "安打": false,
            "本塁打": false,
            "塁打": false,
            "犠打": false,
            "犠飛": false,
            "四球": false,
            "死球": false,
            "三振": true,
            "打撃妨害出塁": false,
            "走塁妨害出塁": false,
            "得点": false,
            "打点": false
          }
        },
