    "HistoryEntry": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "confirmed-play"
        },
        "difference": {
          "type": "object",
          "properties": {
            "stateFields": {
              "$ref": "#/$defs/StateDifference"
            },
            "scoreboard": {
              "$ref": "#/$defs/ScoreboardDifference"
            },
            "statFlags": {
              "$ref": "#/$defs/StatFlags"
            },
            "battingOrderBySide": {
              "$ref": "#/$defs/CursorDifference"
            }
          },
          "required": [
            "stateFields",
            "scoreboard",
            "statFlags"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "difference"
      ],
      "additionalProperties": false
    },
    "BattingOrderBySide": {
      "type": "object",
      "properties": {
        "away": {
          "enum": [
            "1",
            "2",
            "3",
            "4",
            "5",
            "6",
            "7",
            "8",
            "9"
          ],
          "x-pitchlog-axis-id": "state.battingOrder",
          "$comment": "既descriptor同軸の独立context写像。active値一致・inactive独立性は相関検査。"
        },
        "home": {
          "enum": [
            "1",
            "2",
            "3",
            "4",
            "5",
            "6",
            "7",
            "8",
            "9"
          ],
          "x-pitchlog-axis-id": "state.battingOrder",
          "$comment": "既descriptor同軸の独立context写像。active値一致・inactive独立性は相関検査。"
        }
      },
      "required": [
        "away",
        "home"
      ],
      "additionalProperties": false
    },
    "CursorDifference": {
      "type": "object",
      "properties": {
        "away": {
          "type": "object",
          "properties": {
            "before": {
              "enum": [
                "1",
                "2",
                "3",
                "4",
                "5",
                "6",
                "7",
                "8",
                "9"
              ]
            },
            "after": {
