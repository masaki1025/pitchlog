{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pitchlog.local/contracts/state-transition/strikeout_pitch_schema_v1.json",
  "title": "正規捕球の三振と第3アウト・両チーム打順T1候補 v1",
  "$comment": "未受理候補。要求応答相関・真正source・T2・保存は別検査。旧ABIを変更しない。",
  "oneOf": [
    {
      "$ref": "#/$defs/StrikeoutPitchRequest"
    },
    {
      "$ref": "#/$defs/StrikeoutPitchResponse"
    }
  ],
  "$defs": {
    "CanonicalUnsigned": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"
    },
    "CanonicalPositive": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(?![\\s\\S])"
    },
    "Score": {
      "type": "object",
      "properties": {
        "home": {
          "$ref": "#/$defs/CanonicalUnsigned"
        },
        "away": {
          "$ref": "#/$defs/CanonicalUnsigned"
        }
      },
      "required": [
        "home",
        "away"
      ],
      "additionalProperties": false
    },
    "StateFields": {
      "type": "object",
      "properties": {
        "state.half": {
          "enum": [
            "top",
            "bottom"
          ]
        },
        "state.count.strikes": {
          "$ref": "#/$defs/CanonicalUnsigned"
        },
        "state.count.balls": {
          "$ref": "#/$defs/CanonicalUnsigned"
        },
        "state.outs": {
          "$ref": "#/$defs/CanonicalUnsigned"
        },
        "state.runners": {
          "enum": [
            "empty",
            "first",
            "second",
            "third",
            "first-second",
            "first-third",
            "second-third",
            "first-second-third"
          ]
        },
        "state.battingOrder": {
          "$ref": "#/$defs/CanonicalUnsigned"
        },
        "state.tiebreakActive": {
          "type": "boolean"
        },
        "state.gameEnded": {
          "type": "boolean"
        },
        "state.inning": {
          "$ref": "#/$defs/CanonicalPositive"
        },
        "state.score": {
          "$ref": "#/$defs/Score"
        }
      },
      "required": [
        "state.half",
        "state.count.strikes",
        "state.count.balls",
        "state.outs",
        "state.runners",
        "state.battingOrder",
        "state.tiebreakActive",
        "state.gameEnded",
        "state.inning",
        "state.score"
      ],
      "additionalProperties": false
    },
    "Scoreboard": {
      "type": "object",
      "properties": {
        "inningScores": {
          "$ref": "#/$defs/Score"
        },
        "hits": {
          "$ref": "#/$defs/CanonicalUnsigned"
        },
        "errors": {
          "$ref": "#/$defs/CanonicalUnsigned"
        },
        "strikeouts": {
          "$ref": "#/$defs/CanonicalUnsigned"
        },
        "walks": {
          "$ref": "#/$defs/CanonicalUnsigned"
        }
      },
      "required": [
        "inningScores",
        "hits",
        "errors",
        "strikeouts",
        "walks"
      ],
      "additionalProperties": false
    },
    "Snapshot": {
      "type": "object",
      "properties": {
        "stateFields": {
          "$ref": "#/$defs/StateFields"
        },
        "scoreboard": {
          "$ref": "#/$defs/Scoreboard"
        },
        "battingOrderBySide": {
          "$ref": "#/$defs/BattingOrderBySide"
        }
      },
      "required": [
        "stateFields",
        "scoreboard",
        "battingOrderBySide"
      ],
      "additionalProperties": false
    },
    "StatFlags": {
      "type": "object",
      "properties": {
        "投球回算入アウト": {
          "type": "boolean"
        },
        "投球数": {
          "type": "boolean"
        },
        "奪三振": {
          "type": "boolean"
        },
        "与四球": {
          "type": "boolean"
        },
        "与死球": {
          "type": "boolean"
        },
        "被安打": {
          "type": "boolean"
        },
        "被本塁打": {
          "type": "boolean"
        },
        "失点": {
          "type": "boolean"
        },
        "失策": {
          "type": "boolean"
        },
        "打席": {
          "type": "boolean"
        },
        "打数": {
          "type": "boolean"
        },
        "安打": {
          "type": "boolean"
        },
        "本塁打": {
          "type": "boolean"
        },
        "塁打": {
          "type": "boolean"
        },
        "犠打": {
          "type": "boolean"
        },
        "犠飛": {
          "type": "boolean"
        },
        "四球": {
          "type": "boolean"
        },
        "死球": {
          "type": "boolean"
        },
        "三振": {
          "type": "boolean"
        },
        "打撃妨害出塁": {
          "type": "boolean"
        },
        "走塁妨害出塁": {
          "type": "boolean"
        },
        "得点": {
          "type": "boolean"
        },
        "打点": {
          "type": "boolean"
        }
      },
      "required": [
        "投球回算入アウト",
        "投球数",
        "奪三振",
        "与四球",
        "与死球",
        "被安打",
        "被本塁打",
        "失点",
        "失策",
        "打席",
        "打数",
        "安打",
        "本塁打",
        "塁打",
        "犠打",
        "犠飛",
        "四球",
        "死球",
        "三振",
        "打撃妨害出塁",
        "走塁妨害出塁",
        "得点",
        "打点"
      ],
      "additionalProperties": false
    },
    "StateDifference": {
      "type": "object",
      "properties": {
        "state.half": {
          "type": "object",
          "properties": {
            "before": {
              "enum": [
                "top",
                "bottom"
              ]
            },
            "after": {
              "enum": [
                "top",
                "bottom"
