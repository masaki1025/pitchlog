    "StrikeoutPitchRequest": {
      "type": "object",
      "properties": {
        "eventKind": {
          "const": "batting-result"
        },
        "resultId": {
          "enum": [
            "batting-result.called-strikeout",
            "batting-result.swinging-strikeout"
          ]
        },
        "pitchEventKind": {
          "const": "pitch-event"
        },
        "before": {
          "type": "object",
          "properties": {
            "stateFields": {
              "type": "object",
              "properties": {
                "state.half": {
                  "enum": [
                    "top",
                    "bottom"
                  ]
                },
                "state.count.strikes": {
                  "const": "2"
                },
                "state.count.balls": {
                  "enum": [
                    "0",
                    "1",
                    "2",
                    "3"
                  ]
                },
                "state.outs": {
                  "enum": [
                    "0",
                    "1",
                    "2"
                  ]
                },
                "state.runners": {
                  "enum": [
                    "empty",
                    "first",
                    "second",
                    "third",
                    "first-second",
                    "first-third",
                    "second-third",
                    "first-second-third"
