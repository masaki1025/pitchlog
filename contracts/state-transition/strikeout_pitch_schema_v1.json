              "$ref": "#/$defs/CanonicalUnsigned"
            },
            "after": {
              "$ref": "#/$defs/CanonicalUnsigned"
            }
          },
          "required": [
            "before",
            "after"
          ],
          "additionalProperties": false
        },
        "strikeouts": {
          "type": "object",
          "properties": {
            "before": {
              "$ref": "#/$defs/CanonicalUnsigned"
            },
            "after": {
              "$ref": "#/$defs/CanonicalUnsigned"
            }
          },
          "required": [
            "before",
            "after"
          ],
          "additionalProperties": false
