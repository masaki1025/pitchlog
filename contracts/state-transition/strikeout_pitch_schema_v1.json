          "additionalProperties": false
        },
        "state.count.strikes": {
          "type": "object",
          "properties": {
            "before": {
              "$ref": "#/$defs/CanonicalUnsigned"
            },
            "after": {
              "$ref": "#/$defs/CanonicalUnsigned"
