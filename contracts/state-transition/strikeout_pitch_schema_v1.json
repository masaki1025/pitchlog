          "required": [
            "before",
            "after"
          ],
          "additionalProperties": false
        },
        "state.gameEnded": {
          "type": "object",
          "properties": {
            "before": {
              "type": "boolean"
            },
            "after": {
              "type": "boolean"
            }
          },
          "required": [
            "before",
            "after"
          ],
          "additionalProperties": false
        },
        "state.inning": {
          "type": "object",
          "properties": {
            "before": {
              "$ref": "#/$defs/CanonicalPositive"
            },
            "after": {
              "$ref": "#/$defs/CanonicalPositive"
            }
          },
          "required": [
            "before",
            "after"
          ],
          "additionalProperties": false
        },
        "state.score": {
          "type": "object",
          "properties": {
            "before": {
              "$ref": "#/$defs/Score"
            },
            "after": {
              "$ref": "#/$defs/Score"
            }
          },
          "required": [
            "before",
            "after"
          ],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "ScoreboardDifference": {
      "type": "object",
      "properties": {
        "inningScores": {
          "type": "object",
          "properties": {
            "before": {
              "$ref": "#/$defs/Score"
            },
            "after": {
              "$ref": "#/$defs/Score"
            }
          },
          "required": [
            "before",
            "after"
          ],
          "additionalProperties": false
