        "state.runners": {
          "type": "object",
          "properties": {
            "before": {
              "enum": [
                "empty",
                "first",
                "second",
                "third",
                "first-second",
                "first-third",
                "second-third",
                "first-second-third"
              ]
            },
            "after": {
              "enum": [
                "empty",
                "first",
                "second",
                "third",
                "first-second",
                "first-third",
                "second-third",
                "first-second-third"
              ]
            }
          },
          "required": [
            "before",
            "after"
          ],
          "additionalProperties": false
        },
        "state.battingOrder": {
          "type": "object",
