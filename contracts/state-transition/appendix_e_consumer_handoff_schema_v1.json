{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pitchlog.local/contracts/state-transition/appendix_e_consumer_handoff_schema_v1.json",
  "title": "Pitchlog Appendix E consumer handoff schema v1, step 110",
  "version": "appendix_e_consumer_handoff_schema_v1",
  "type": "object",
  "required": [
    "handoffVersion",
    "calculationIds",
    "claimBoundary",
    "consumerBindings",
    "artifacts",
    "dependencies",
    "receiverDoD",
    "fr040Declaration",
    "descriptorParity",
    "consumptionVerification",
    "stage2EntryGate",
    "receiverTaskId"
  ],
  "additionalProperties": false,
  "properties": {
    "handoffVersion": {
      "const": "appendix_e_consumer_handoff_v1"
    },
    "calculationIds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claimBoundary": {
      "type": "object",
      "required": [
        "guaranteed",
        "notGuaranteed"
      ],
      "additionalProperties": false,
      "properties": {
        "guaranteed": {
          "type": "string",
          "minLength": 1
        },
        "notGuaranteed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "consumerBindings": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/consumerBinding"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "receiverDoD": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fr040Declaration": {
      "$ref": "#/$defs/fr040Declaration"
    },
    "descriptorParity": {
      "$ref": "#/$defs/descriptorParity"
    },
    "consumptionVerification": {
      "const": "pending"
    },
    "stage2EntryGate": {
      "$ref": "#/$defs/stage2EntryGate"
    },
    "receiverTaskId": {
      "type": "string",
      "pattern": "^TSK-[1-9][0-9]*$",
      "$comment": "段階2の受取タスクはTSK-538として確定した。nullと不正なタスクIDは受理しない。"
    }
  },
  "$defs": {
    "consumerBinding": {
      "type": "object",
      "required": [
        "calculationId",
        "vectorId",
        "contractPath",
        "version",
        "schemaVersion",
        "caseSchemaRef",
        "caseFieldMapping",
        "normalizationComparison",
        "outputComparison",
        "dPlusOnePolicy",
        "executionPaths"
      ],
      "additionalProperties": false,
      "properties": {
        "calculationId": {
          "type": "string",
          "minLength": 1
        },
        "vectorId": {
          "type": "string",
          "minLength": 1
        },
        "contractPath": {
          "type": "string",
          "pattern": "^contracts/state-transition/[a-z_]+_contract_v[1-9][0-9]*\\.json$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "caseSchemaRef": {
          "$ref": "#/$defs/schemaPointer"
        },
        "caseFieldMapping": {
          "$ref": "#/$defs/caseFieldMapping"
        },
        "normalizationComparison": {
          "enum": [
            "exact",
            "lossless"
          ]
        },
        "outputComparison": {
          "enum": [
            "exact",
            "lossless"
          ]
        },
        "dPlusOnePolicy": {
          "const": "liveness-only",
          "$comment": "保証境界: D+1 のundo liveness-only行には拒否しない・切り捨てないことだけを要求し、出力同値は要求しない。ステップ66のPO裁定でこのundo行は段階2へ送られ、現行の該当行・caseは存在しない。matrixRowsにはD+1入力のcaseがあるが、この方針の実証には数えない。この宣言は行の消費やlivenessの実証ではない。"
        },
        "executionPaths": {
          "$ref": "#/$defs/executionPaths"
        }
      }
    },
    "executionPaths": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/executionPath"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "runner": {
                "const": "pytest"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "runner": {
                "const": "vitest"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "$comment": "各bindingの実行経路はpytestとvitestのexact-set。runner実装は存在するが、3識別子とrunner revisionは契約上まだ未確定であり、全caseの消費は保証しない。"
    },
    "executionPath": {
      "type": "object",
      "required": [
        "runner",
        "runnerRevision",
        "normalizerId",
        "entrypointId",
        "directTargetId",
        "resolutionStage"
      ],
      "additionalProperties": false,
      "properties": {
        "runner": {
          "enum": [
            "pytest",
            "vitest"
          ]
        },
        "runnerRevision": {
          "const": "pending"
        },
        "normalizerId": {
          "type": "null"
        },
        "entrypointId": {
          "type": "null"
        },
        "directTargetId": {
          "type": "null"
        },
        "resolutionStage": {
          "const": "stage-2"
        }
      },
      "$comment": "runner実装は存在するが、製品計算へのbindingの3識別子は未確定のためnullとする。段階2で実在値に解決する。"
    },
    "caseFieldMapping": {
      "$comment": "contractPointerは各cases[]要素を起点とし、runnerPointerは受取側caseを起点とする。両契約の/rawと/normalizedはそれぞれrunnerの同名フィールドへ写す。期待値は状況判定の/expectedと終了判定の/decisionをrunnerの/expectedへ写す。両契約のinputCoordinateは/normalizedと一致し、終了判定の非identity規則のケースでは/rawが表示名を保持する。この写像はrunner消費を証明しない。",
      "type": "object",
      "required": [
        "id",
        "input",
        "expected",
        "tags"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/caseIdMapping"
        },
        "input": {
          "type": "object",
          "required": [
            "raw",
            "normalized"
          ],
          "additionalProperties": false,
          "properties": {
            "raw": {
              "$ref": "#/$defs/rawMapping"
            },
            "normalized": {
              "$ref": "#/$defs/normalizedMapping"
            }
          }
        },
        "expected": {
          "$ref": "#/$defs/expectedMapping"
        },
        "tags": {
          "$ref": "#/$defs/absentTagsMapping"
        }
      }
    },
    "caseIdMapping": {
      "type": "object",
      "required": [
        "contractPointer",
        "runnerPointer"
      ],
      "additionalProperties": false,
      "properties": {
        "contractPointer": {
          "$ref": "#/$defs/casePointer"
        },
        "runnerPointer": {
          "const": "/caseId"
        }
      }
    },
    "rawMapping": {
      "type": "object",
      "required": [
        "contractPointer",
        "runnerPointer"
      ],
      "additionalProperties": false,
      "properties": {
        "contractPointer": {
          "$ref": "#/$defs/casePointer"
        },
        "runnerPointer": {
          "const": "/raw"
        }
      }
    },
    "normalizedMapping": {
      "type": "object",
      "required": [
        "contractPointer",
        "runnerPointer"
      ],
      "additionalProperties": false,
      "properties": {
        "contractPointer": {
          "$ref": "#/$defs/casePointer"
        },
        "runnerPointer": {
          "const": "/normalized"
        }
      }
    },
    "expectedMapping": {
      "type": "object",
      "required": [
        "contractPointer",
        "runnerPointer"
      ],
      "additionalProperties": false,
      "properties": {
        "contractPointer": {
          "$ref": "#/$defs/casePointer"
        },
        "runnerPointer": {
          "const": "/expected"
        }
      }
    },
    "absentTagsMapping": {
      "type": "object",
      "required": [
        "contractPointer",
        "runnerPointer",
        "availability"
      ],
      "additionalProperties": false,
      "properties": {
        "contractPointer": {
          "const": null
        },
        "runnerPointer": {
          "const": "/tags"
        },
        "availability": {
          "const": "absent"
        }
      },
      "$comment": "現行の2契約の全caseにtagsは無い。存在しないcontractPointerを捏造しない。"
    },
    "casePointer": {
      "type": "string",
      "pattern": "^/(?:[^~/]|~[01])*(?:/(?:[^~/]|~[01])*)*$",
      "$comment": "RFC 6901のJSON Pointer。各cases[]要素を起点とする。"
    },
    "schemaPointer": {
      "type": "string",
      "pattern": "^#/(?:[^~/]|~[01])*(?:/(?:[^~/]|~[01])*)*$"
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "version",
        "digest"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^contracts/state-transition/[a-z_]+_v[1-9][0-9]*\\.json$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "$comment": "digestはファイル全byteのSHA-256。実ファイルとの照合はtests/test_consumer_handoff.pyで行う。"
    },
    "dependency": {
      "type": "object",
      "required": [
        "taskId",
        "artifactPath",
        "commitOid",
        "version",
        "establishmentCondition"
      ],
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "type": "string",
          "pattern": "^TSK-[1-9][0-9]*$"
        },
        "artifactPath": {
          "type": "string",
          "minLength": 1
        },
        "commitOid": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "establishmentCondition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fr040Declaration": {
      "type": "object",
      "required": [
        "content",
        "basis",
        "recordStage",
        "recordTarget"
      ],
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "recordStage": {
          "const": "stage-2"
        },
        "recordTarget": {
          "const": "製品manifest"
        }
      }
    },
    "descriptorParity": {
      "type": "object",
      "required": [
        "descriptorPath",
        "descriptorId",
        "projectionRulesPointer",
        "designPath",
        "designSection",
        "requirement",
        "verificationStage"
      ],
      "additionalProperties": false,
      "properties": {
        "descriptorPath": {
          "const": "contracts/state-transition/input_axes_descriptor_v1.json"
        },
        "descriptorId": {
          "const": "pitchlog.input-axes"
        },
        "projectionRulesPointer": {
          "const": "/projectionRules"
        },
        "designPath": {
          "const": "docs/features/appendix-e-golden-vectors/design.md"
        },
        "designSection": {
          "const": "3-4"
        },
        "requirement": {
          "type": "string",
          "minLength": 1
        },
        "verificationStage": {
          "const": "stage-2"
        }
      }
    },
    "stage2EntryGate": {
      "type": "object",
      "required": [
        "topLevelLoad",
        "versionCheck",
        "bindingConstruction",
        "allCasesConsumption",
        "dPlusOnePrerequisite"
      ],
      "additionalProperties": false,
      "properties": {
        "topLevelLoad": {
          "type": "string",
          "minLength": 1
        },
        "versionCheck": {
          "type": "string",
          "minLength": 1
        },
        "bindingConstruction": {
          "type": "string",
          "minLength": 1
        },
        "allCasesConsumption": {
          "type": "string",
          "minLength": 1
        },
        "dPlusOnePrerequisite": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
