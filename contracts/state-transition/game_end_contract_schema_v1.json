{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pitchlog.local/contracts/state-transition/game_end_contract_schema_v1.json",
  "title": "Pitchlog game end contract schema v1",
  "version": "game_end_contract_schema_v1",
  "x-pitchlog-descriptor-identity-binding": {
    "contractField": "inputAxesDescriptor",
    "schemaDefinition": "inputAxesDescriptorBinding"
  },
  "x-pitchlog-rule-snapshot-definition": "#/$defs/ruleSnapshot",
  "x-pitchlog-decision-row-references": {
    "branchRegisterPath": "contracts/state-transition/clause_branch_register_v1.json",
    "requiredBranchKind": "game-end-outcome",
    "requiredCoverageKind": "decision-row",
    "implementedBranchIds": [
      "GAME-END-NORMAL",
      "GAME-END-EXTRA-CONTINUE",
      "GAME-END-LIMIT-DRAW",
      "GAME-END-TIEBREAK-CONTINUE",
      "COLD-08",
      "COLD-09",
      "GAME-END-WALK-OFF",
      "XMARK-02"
    ],
    "branchClassificationOverrides": {
      "COLD-08": {
        "branchKind": "requirement-branch-row",
        "coverageKind": "normative-case"
      },
      "COLD-09": {
        "branchKind": "requirement-branch-row",
        "coverageKind": "normative-case"
      },
      "XMARK-02": {
        "branchKind": "requirement-branch-row",
        "coverageKind": "normative-case"
      }
    },
    "outcomeByBranchId": {
      "GAME-END-NORMAL": "normal-end",
      "GAME-END-EXTRA-CONTINUE": "extra-continue",
      "GAME-END-LIMIT-DRAW": "limit-draw",
      "GAME-END-TIEBREAK-CONTINUE": "tiebreak-continue",
      "COLD-08": "cold-end",
      "COLD-09": "cold-end",
      "GAME-END-WALK-OFF": "walk-off",
      "XMARK-02": "normal-end"
    },
    "outcomeSourceClauseIds": {
      "normal-end": ["req:FR-005", "req:F-1"],
      "extra-continue": ["req:F-1"],
      "limit-draw": ["req:F-1"],
      "tiebreak-continue": ["req:FR-009", "req:F-1"],
      "cold-end": ["req:FR-005", "req:F-1"],
      "walk-off": ["req:FR-005", "req:FR-020"]
    },
    "axisDescriptorPath": "contracts/state-transition/input_axes_descriptor_v1.json",
    "evaluationPoint": "post-confirmed-play-and-after-switch-if-third-out",
    "allowedAxisIds": [
      "gameEnd.regulationInnings",
      "gameEnd.coldConditions",
      "gameEnd.satisfiedColdTierCount",
      "gameEnd.extensionLimit",
      "gameEnd.tiebreak",
      "state.inning",
      "state.half",
      "state.score",
      "state.outs",
      "state.runners",
      "state.count.strikes",
      "state.count.balls",
      "state.gameEnded",
      "state.tiebreakActive",
      "event.operationKind",
      "event.operationPayload",
      "event.perPitch.kind",
      "event.perPitch.resultId",
      "event.perPitch.pitchEventKind",
      "event.perPitch.runnerEventPayload",
      "event.perPitch.runnerAdvanceOverridesByRunner",
      "event.perPitch.thirdOutTimingByRunner",
      "event.perPitch.interferenceRuling",
      "event.perPitch.officialScoringPayload",
      "event.perPitch.rbi.doublePlayRelayError",
      "event.perPitch.rbi.runnerContinuityByRunner",
      "event.perPitch.rbi.wouldScoreWithoutErrorByRunner"
    ],
    "valueFieldsByClassification": {
      "finite-enumerable": "values",
      "boundary-partition": "boundaryValues"
    }
  },
  "x-pitchlog-descriptor-projection": {
    "descriptorPath": "contracts/state-transition/input_axes_descriptor_v1.json",
    "identityDefinition": "inputAxesDescriptorBinding",
    "coverageCollection": "gameEndAxes",
    "coverageTargetAnnotation": "x-pitchlog-axis-id",
    "nonCoverageCollection": "nonCoverageFields",
    "nonCoverageTargetAnnotation": "x-pitchlog-non-coverage-field",
    "schemaRetentionAnnotation": "x-pitchlog-schema-retention",
    "requiredSchemaRetention": "required-by-projection"
  },
  "x-pitchlog-provenance-policy": {
    "recordLocation": "contract-top-level",
    "recordField": "provenance",
    "sourceKinds": {
      "requirements": {
        "priority": 1,
        "verificationMode": "repository-clause-id-existence",
        "sourcePath": "docs/requirements/requirements-pitchlog-2026-07-22.md",
        "sourceIdNamespace": "req",
        "machineCapability": "identifier-existence"
      },
      "official-baseball-rules": {
        "priority": 2,
        "verificationMode": "identifier-format-only",
        "sourceIdPattern": "^obr:[1-9][0-9]*\\.[0-9]{2}(?:\\([a-z0-9]+\\))*$",
        "machineCapability": "identifier-format-only",
        "notMechanicallyVerified": [
          "rule-number-existence",
          "rule-content"
        ]
      },
      "legacy-vocab-mirror": {
        "priority": 3,
        "verificationMode": "vocabulary-id-existence-via-manifest",
        "manifestPath": "contracts/vocabulary/vocabulary_manifest_v1.json",
        "machineCapability": "vocabulary-id-existence"
      },
      "legacy-research": {
        "priority": 4,
        "verificationMode": "repository-line-reference-existence",
        "pathRoot": "docs/legacy/research",
        "sourceIdPattern": "^(?P<path>docs/legacy/research/[A-Za-z0-9._/-]+\\.md):(?P<line>[1-9][0-9]*)$",
        "machineCapability": "path-and-line-existence"
      }
    },
    "subjectKinds": {
      "normative-branch-or-state-effect": {
        "sufficientSourceKinds": [
          "requirements",
          "official-baseball-rules"
        ]
      },
      "vocabulary-origin": {
        "sufficientSourceKinds": [
          "requirements",
          "official-baseball-rules",
          "legacy-vocab-mirror"
        ]
      }
    },
    "attestationItems": {
      "direct-source-clause-review": {
        "acceptedResponses": [
          true
        ],
        "humanMeaning": "独立確認者が典拠の条文そのものから確認し、導出物・生成物・他者の要約を根拠にしていない"
      },
      "author-work-exposure": {
        "acceptedResponses": [
          "not-seen-before-source-review",
          "seen-and-recorded"
        ],
        "humanMeaning": "作成者の作業結果を見る前に典拠を読んだか、見た場合はその事実を記録した"
      },
      "source-support-judgment": {
        "acceptedResponses": [
          true
        ],
        "humanMeaning": "典拠が主張を支持すると独立確認者が判断した"
      }
    },
    "assuranceBoundary": {
      "mechanicallyGuaranteed": [
        "source-reference-within-declared-machine-capability",
        "recorded-author-and-independent-verifier-are-different",
        "attestation-record-exact-set-and-accepted-responses"
      ],
      "humanControls": [
        "independent-review-actually-performed",
        "attestations-are-truthful",
        "source-supports-claim",
        "official-rule-number-exists-and-content-is-correct",
        "vocabulary-mirror-version-is-correct",
        "legacy-research-is-suitable-corroboration"
      ],
      "step43Excluded": "approved成果物の別人による条文からの直接レビュー署名はステップ43が所有する"
    }
  },
  "type": "object",
  "required": [
    "schemaVersion",
    "version",
    "calculation",
    "inputAxesDescriptor",
    "provenance",
    "decisionRows",
    "requiredSet",
    "cases",
    "validationErrors"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer"
    },
    "version": {
      "type": "string",
      "pattern": "^[a-z]+(?:_[a-z]+)*_v[1-9][0-9]*$"
    },
    "calculation": {
      "type": "string",
      "minLength": 1
    },
    "inputAxesDescriptor": {
      "$ref": "#/$defs/inputAxesDescriptorBinding"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "decisionRows": {
      "x-pitchlog-normative-row-layer": true,
      "type": "array",
      "items": {
        "$ref": "#/$defs/decisionRow"
      }
    },
    "requiredSet": {
      "type": "object",
      "additionalProperties": true
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/normalizedCase"
      }
    },
    "validationErrors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validationError"
      }
    }
  },
  "$defs": {
    "normalizedCase": {
      "type": "object",
      "required": ["caseId", "branchId", "rowRef", "inputCoordinate", "decision", "raw", "normalizationRuleId", "normalized", "derivedSourceInput"],
      "additionalProperties": true,
      "properties": {
        "caseId": {"type": "string", "minLength": 1},
        "branchId": {"type": "string", "minLength": 1},
        "rowRef": {"type": "object"},
        "inputCoordinate": {
          "type": "object",
          "required": ["gameEnd.satisfiedColdTierCount"],
          "properties": {
            "gameEnd.satisfiedColdTierCount": {
              "description": "F-1 COLD-07〜09。確定プレイ後に成立したコールド段の件数。規則設定の段数と区別する。",
              "x-pitchlog-axis-id": "gameEnd.satisfiedColdTierCount",
              "x-pitchlog-axis-classification": "boundary-partition",
              "x-pitchlog-coverage-bounds": [{"dimension": "satisfiedTierCount", "minimum": 0, "maximum": 16}],
              "x-pitchlog-boundary-values": [0, 1, 2, 16],
              "type": "integer",
              "minimum": 0,
              "maximum": 16
            }
          }
        },
        "decision": {"$ref": "#/$defs/gameEndDecision"},
        "raw": {"type": "object"},
        "normalizationRuleId": {"enum": ["identity", "game-end-result-display-name-to-id"]},
        "normalized": {"type": "object"},
        "derivedSourceInput": {
          "description": "派生値の関数性を比較する具体入力。代表ラベルではなく各段の点差・開始回と状態の実値を持つ。",
          "type": "object",
          "required": ["gameEnd.coldConditions", "state.inning", "state.half", "state.score"],
          "additionalProperties": false,
          "properties": {
            "gameEnd.coldConditions": {
              "type": "array", "maxItems": 16,
              "items": {"$ref": "#/$defs/coldConditionTier"}
            },
            "state.inning": {"type": "integer", "minimum": 1, "maximum": 99},
            "state.half": {"enum": ["top", "bottom"]},
            "state.score": {
              "type": "object", "required": ["home", "away"], "additionalProperties": false,
              "properties": {
                "home": {"type": "integer", "minimum": 0},
                "away": {"type": "integer", "minimum": 0}
              }
            }
          }
        }
      }
    },
    "validationError": {
      "type": "object",
      "required": ["axisId", "invalidValue", "valueIdentity", "sourceClauseIds", "expected", "claimBoundary"],
      "additionalProperties": false,
      "properties": {
        "axisId": {"type": "string", "pattern": "^gameEnd\\."},
        "invalidValue": {"oneOf": [{"type": "integer"}, {"type": "string"}]},
        "valueIdentity": {"type": "string", "minLength": 1},
        "sourceClauseIds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "expected": {"const": "reject-invalid-rule-setting"},
        "claimBoundary": {
          "type": "object",
          "required": ["guaranteed", "notGuaranteed"],
          "additionalProperties": false,
          "properties": {
            "guaranteed": {"type": "string", "minLength": 1},
            "notGuaranteed": {"type": "string", "pattern": "保証範囲外"}
          }
        }
      }
    },
    "decisionRow": {
      "type": "object",
      "required": [
        "branchId",
        "sourceClauseIds",
        "precondition",
        "decision",
        "remarks"
      ],
      "additionalProperties": false,
      "properties": {
        "branchId": {
          "type": "string",
          "minLength": 1
        },
        "sourceClauseIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^req:[A-Za-z0-9-]+$"
          }
        },
        "precondition": {
          "$ref": "#/$defs/decisionPredicate"
        },
        "decision": {
          "$ref": "#/$defs/gameEndDecision"
        },
        "remarks": {
          "type": "string"
        }
      }
    },
    "decisionPredicate": {
      "oneOf": [
        {
          "type": "object",
          "required": ["op", "args"],
          "additionalProperties": false,
          "properties": {
            "op": {"enum": ["and", "or"]},
            "args": {
              "type": "array",
              "minItems": 2,
              "items": {"$ref": "#/$defs/decisionPredicate"}
            }
          }
        },
        {
          "type": "object",
          "required": ["op", "args"],
          "additionalProperties": false,
          "properties": {
            "op": {"const": "not"},
            "args": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {"$ref": "#/$defs/decisionPredicate"}
            }
          }
        },
        {
          "type": "object",
          "required": ["op", "axisId", "value"],
          "additionalProperties": false,
          "properties": {
            "op": {"const": "eq"},
            "axisId": {"type": "string", "minLength": 1},
            "value": {"oneOf": [{"type": "integer"}, {"type": "boolean"}, {"type": "string"}]}
          }
        }
      ]
    },
    "gameEndDecision": {
      "type": "object",
      "required": [
        "outcome",
        "endConditionDetected",
        "lockFurtherPlayInput",
        "promptEndDeclaration",
        "automaticallyEndsGame",
        "xMark"
      ],
      "additionalProperties": false,
      "properties": {
        "outcome": {"enum": ["normal-end", "extra-continue", "limit-draw", "tiebreak-continue", "cold-end", "walk-off"]},
        "endConditionDetected": {"type": "boolean"},
        "lockFurtherPlayInput": {"type": "boolean"},
        "promptEndDeclaration": {"type": "boolean"},
        "automaticallyEndsGame": {"type": "boolean"},
        "xMark": {
          "description": "直近に完了した表と対になる裏の得点セルの表示種別。recorded-scoreは別途集計した非負整数、x-markは未開始の裏に適用するX、blankはそれ以外の未開始セルを写像①で表示する。表示文字列や得点値はこの欄に含めない。FR-020 XMARK-01〜03。",
          "enum": ["recorded-score", "x-mark", "blank"]
        }
      }
    },
    "inputAxesDescriptorBinding": {
      "type": "object",
      "required": [
        "descriptorId",
        "version",
        "digest"
      ],
      "additionalProperties": false,
      "properties": {
        "descriptorId": {
          "const": "pitchlog.input-axes"
        },
        "version": {
          "const": "input_axes_descriptor_v1"
        },
        "digest": {
          "const": "sha256:5107f929d35ae48e01e25e0410a95235521b778ce53bae945ca5d7e2e956dd57"
        }
      }
    },
    "ruleSnapshot": {
      "type": "object",
      "required": [
        "regulationInnings",
        "coldConditions",
        "extensionLimit",
        "tiebreak",
        "dh"
      ],
      "additionalProperties": false,
      "properties": {
        "regulationInnings": {
          "x-pitchlog-axis-id": "gameEnd.regulationInnings",
          "x-pitchlog-axis-classification": "boundary-partition",
          "x-pitchlog-coverage-bounds": [
            {
              "dimension": "innings",
              "minimum": 1,
              "maximum": 99
            }
          ],
          "x-pitchlog-boundary-values": [
            1,
            5,
            7,
            9,
            99
          ],
          "x-pitchlog-invalid-boundary-values": [
            0,
            100
          ],
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "coldConditions": {
          "x-pitchlog-axis-id": "gameEnd.coldConditions",
          "x-pitchlog-axis-classification": "boundary-partition",
          "x-pitchlog-coverage-bounds": [
            {
              "dimension": "pointDifference",
              "minimum": 1,
              "maximum": 99
            },
            {
              "dimension": "startInning",
              "minimum": 1,
              "maximum": 99
            },
            {
              "dimension": "tierCount",
              "minimum": 0,
              "maximum": 16
            }
          ],
          "x-pitchlog-boundary-values": [
            "tier-count:0",
            "tier-count:1",
            "tier-count:2",
            "tier-count:16",
            "point-difference:1",
            "point-difference:M-1",
            "point-difference:M",
            "point-difference:M+1",
            "point-difference:99",
            "start-inning:1",
            "start-inning:N-1",
            "start-inning:N",
            "start-inning:N+1",
            "start-inning:99"
          ],
          "x-pitchlog-invalid-boundary-values": [
            "tier-count:17",
            "point-difference:0",
            "point-difference:100",
            "start-inning:0",
            "start-inning:100"
          ],
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/coldConditionTier"
          }
        },
        "extensionLimit": {
          "x-pitchlog-axis-id": "gameEnd.extensionLimit",
          "x-pitchlog-axis-classification": "boundary-partition",
          "x-pitchlog-coverage-bounds": [
            {
              "dimension": "innings",
              "minimum": 1,
              "maximum": 99
            }
          ],
          "x-pitchlog-boundary-values": [
            "none",
            "finite:R",
            "finite:R+1",
            "finite:99"
          ],
          "x-pitchlog-invalid-boundary-values": [
            "finite:R-1",
            "finite:100"
          ],
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 99
            },
            {
              "type": "null"
            }
          ]
        },
        "tiebreak": {
          "x-pitchlog-axis-id": "gameEnd.tiebreak",
          "x-pitchlog-axis-classification": "boundary-partition",
          "x-pitchlog-coverage-bounds": [
            {
              "dimension": "startInning",
              "minimum": 1,
              "maximum": 99
            }
          ],
          "x-pitchlog-boundary-values": [
            "none",
            "start:R+1",
            "start:L",
            "start:99"
          ],
          "x-pitchlog-invalid-boundary-values": [
            "start:R",
            "start:L+1-when-finite",
            "start:100"
          ],
          "oneOf": [
            {
              "$ref": "#/$defs/tiebreakRule"
            },
            {
              "type": "null"
            }
          ]
        },
        "dh": {
          "x-pitchlog-non-coverage-field": "dh",
          "x-pitchlog-non-coverage-reason": "DH制は打順の構成に影響するが、F-1の終了条件の成立判定には参照されない",
          "x-pitchlog-schema-retention": "required-by-projection",
          "type": "boolean"
        }
      }
    },
    "coldConditionTier": {
      "type": "object",
      "required": [
        "pointDifference",
        "startInning"
      ],
      "additionalProperties": false,
      "properties": {
        "pointDifference": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "startInning": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        }
      }
    },
    "tiebreakRule": {
      "type": "object",
      "required": [
        "startInning",
        "runnerPlacement",
        "leadoffRule"
      ],
      "additionalProperties": false,
      "properties": {
        "startInning": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "runnerPlacement": {
          "x-pitchlog-non-coverage-field": "tiebreak.runnerPlacement",
          "x-pitchlog-non-coverage-reason": "走者配置はタイブレーク開始時の初期状態を定めるが、終了条件の判定には参照されない",
          "x-pitchlog-schema-retention": "required-by-projection",
          "type": "string",
          "minLength": 1
        },
        "leadoffRule": {
          "x-pitchlog-non-coverage-field": "tiebreak.leadoffRule",
          "x-pitchlog-non-coverage-reason": "先頭打者規則はタイブレーク開始時の初期状態を定めるが、終了条件の判定には参照されない",
          "x-pitchlog-schema-retention": "required-by-projection",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "subjectKind",
        "sources",
        "authorId",
        "independentVerifierId",
        "attestations"
      ],
      "additionalProperties": false,
      "properties": {
        "subjectKind": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/provenanceSource"
          }
        },
        "authorId": {
          "type": "string",
          "minLength": 1
        },
        "independentVerifierId": {
          "type": "string",
          "minLength": 1
        },
        "independentReview": {
          "$ref": "#/$defs/provenanceIndependentReview"
        },
        "attestations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/provenanceAttestation"
          }
        }
      }
    },
    "provenanceIndependentReview": {
      "type": "object",
      "required": [
        "verifiedOn",
        "reviewerRole",
        "authorWorkExposure",
        "chronology",
        "findings"
      ],
      "additionalProperties": false,
      "properties": {
        "verifiedOn": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "reviewerRole": {
          "type": "string",
          "minLength": 1
        },
        "authorWorkExposure": {
          "enum": [
            "not-seen-before-source-review",
            "seen-before-source-review"
          ]
        },
        "chronology": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/provenanceReviewEvent"
          }
        },
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenanceReviewEvent": {
      "type": "object",
      "required": [
        "sequence",
        "actorId",
        "activity"
      ],
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "actorId": {
          "type": "string",
          "minLength": 1
        },
        "activity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provenanceSource": {
      "type": "object",
      "required": [
        "sourceKind",
        "sourceId"
      ],
      "additionalProperties": false,
      "properties": {
        "sourceKind": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provenanceAttestation": {
