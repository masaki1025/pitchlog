{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pitchlog.local/contracts/state-transition/gap_register_schema_v1.json",
  "title": "Gap register schema v1",
  "x-pitchlog-gap-register-predicates": {
    "criteriaSource": "contracts/state-transition/input_axes_descriptor_v1.json#/freezeBaseline/criteria/gapRegister",
    "existenceOnlyStages": [
      "clauseIds"
    ],
    "bidirectionalStages": [
      "branchIds",
      "rowIds",
      "fixtureCaseIds",
      "generatedCaseSelector"
    ],
    "resolvedAdditionalBidirectionalStages": [
      "clauseIds"
    ]
  },
  "type": "object",
  "required": [
    "schemaVersion",
    "version",
    "gaps"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "const": "gap_register_v1"
    },
    "gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "gapId",
          "state",
          "clauseIds",
          "branchIds",
          "rowIds",
          "fixtureCaseIds",
          "generatedCaseSelector"
        ],
        "additionalProperties": false,
        "properties": {
          "gapId": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "open",
              "resolved"
            ]
          },
          "clauseIds": {
            "$ref": "#/$defs/uniqueIdList"
          },
          "branchIds": {
            "$ref": "#/$defs/uniqueIdList"
          },
          "rowIds": {
            "$ref": "#/$defs/uniqueIdList"
          },
          "fixtureCaseIds": {
            "$ref": "#/$defs/uniqueIdList"
          },
          "generatedCaseSelector": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1
              },
              {
                "type": "object",
                "minProperties": 1
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "uniqueIdList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
