  "claimBoundary": {
    "machineVerified": [
      "分岐IDの台帳実在、fixture 31 分岐との exact-set および免除 37 分岐との整合",
      "自然キーによる規範行の一意な実在と、状況判定契約の既存行参照との一致",
      "通常fixtureの入力述語・期待値と規範行の一致、交差制約負例の拒否IDと変異の存在",
      "終了判定行自身のbranchIdを正とした対応表との一致、入力述語および期待decisionとの一致",
      "fixture典拠と台帳のsourceClauseIdsに共通の典拠があること"
    ],
    "notGuaranteed": [
      "分岐条文の意味と選んだ規範行との意味的対応は構造検査だけでは証明できず、人間の逐行確認を要する",
      "交差制約負例の候補値が指定したXC規則そのもので拒否される意味的正しさは本対応表検査の保証外である",
      "対応表自身は凍結済み手作業fixtureのbaseline_control射影に含まれず、digest凍結されていない"
    ]
  },
