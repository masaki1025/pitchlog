      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"
    },
    "CanonicalPositive": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(?![\\s\\S])"
    },
    "Score": {
      "type": "object",
      "properties": {
        "home": {
          "$ref": "#/$defs/CanonicalUnsigned"
        },
        "away": {
          "$ref": "#/$defs/CanonicalUnsigned"
        }
      },
      "required": [
        "home",
        "away"
      ],
      "additionalProperties": false
    },
    "StateFields": {
      "type": "object",
      "properties": {
        "state.half": {
          "enum": [
            "top",
            "bottom"
          ]
        },
        "state.count.strikes": {
          "$ref": "#/$defs/CanonicalUnsigned"
        },
        "state.count.balls": {
          "$ref": "#/$defs/CanonicalUnsigned"
        },
        "state.outs": {
          "$ref": "#/$defs/CanonicalUnsigned"
        },
        "state.runners": {
          "enum": [
            "empty",
            "first",
            "second",
            "third",
            "first-second",
            "first-third",
            "second-third",
            "first-second-third"
          ]
        },
        "state.battingOrder": {
          "$ref": "#/$defs/CanonicalUnsigned"
        },
        "state.tiebreakActive": {
          "type": "boolean"
        },
        "state.gameEnded": {
          "type": "boolean"
        },
        "state.inning": {
          "$ref": "#/$defs/CanonicalPositive"
        },
        "state.score": {
          "$ref": "#/$defs/Score"
        }
      },
      "required": [
        "state.half",
        "state.count.strikes",
        "state.count.balls",
        "state.outs",
        "state.runners",
        "state.battingOrder",
        "state.tiebreakActive",
        "state.gameEnded",
        "state.inning",
        "state.score"
