{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pitchlog.local/contracts/state-transition/expander_dependency_policy_schema_v1.json",
  "title": "cases 展開器の依存宣言 schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyId",
    "version",
    "claimBoundary",
    "traceSpec",
    "expanders"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "policyId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "mechanicallyChecked",
        "notGuaranteed",
        "deriverCoverage",
        "fixtureIndependenceClaim",
        "clauseBranchRegisterIndependence"
      ],
      "properties": {
        "subject": {
          "const": "executable-expanders-only"
        },
        "mechanicallyChecked": {
          "const": "observed-file-open-events-during-traced-expander-call"
        },
        "notGuaranteed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "manual-reference-history",
              "semantic-independence-of-allowed-inputs",
              "unexecuted-control-flow",
              "reads-from-file-descriptors-opened-before-tracing",
              "native-reads-without-cpython-audit-events",
              "non-file-inputs",
              "independence-from-clause-branch-register"
            ]
          }
        },
        "deriverCoverage": {
          "const": "not-covered-step-41-policy"
        },
        "fixtureIndependenceClaim": {
          "const": "manual-fixtures-independent-from-expander-only"
        },
        "clauseBranchRegisterIndependence": {
          "const": "not-claimed"
        }
      }
    },
    "traceSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanism",
        "pathIdentity",
        "outsideRepositoryAction",
        "unresolvablePathAction",
        "subprocessAction"
      ],
      "properties": {
        "mechanism": {
          "const": "cpython-audit-open-event"
        },
        "pathIdentity": {
          "const": "resolved-repository-relative-path"
        },
        "outsideRepositoryAction": {
          "const": "fail"
        },
        "unresolvablePathAction": {
          "const": "fail"
        },
        "subprocessAction": {
          "const": "fail-untraced-child"
        }
      }
    },
    "expanders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expanderId",
          "plannedImplementationStep",
          "output",
          "allowedReadPaths"
        ],
        "properties": {
          "expanderId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "plannedImplementationStep": {
            "type": "integer",
            "minimum": 1
          },
          "output": {
            "type": "string",
            "minLength": 1
          },
          "allowedReadPaths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            }
          }
        }
      },
      "x-pitchlog-uniqueBy": "expanderId"
    }
  }
}
