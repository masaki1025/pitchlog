diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -264,8 +264,15 @@
               - 'scripts/design_relations/sync-protocol.json'
               - 'tests/domain/runners/**'
               - 'backend/src/pitchlog/domaincheck/runners/**'
+              - 'backend/**'
+              - 'docs/features/uf8-full-game-followup/step7-candidate/generate.py'
+              - 'pyproject.toml'
+              - 'uv.lock'
+              - 'mise.toml'
+              - '.github/workflows/ci.yml'

   frontend:
+    timeout-minutes: 40
     needs: frontend-changes
     if: >-
       github.event_name == 'workflow_dispatch' ||
@@ -292,6 +299,33 @@
       - run: git diff --exit-code -- public/domain/pitchlog-domain.js public/domain/pitchlog-domain.json
       - run: pnpm run build
       - run: pnpm test -- --run
+      # 製品 App と認証 fixture は使い捨て PostgreSQL にだけ接続する。
+      - uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9 # v9.0.0
+        with:
+          version: "0.8.13"
+          enable-cache: true
+          prune-cache: true
+      - run: uv python install
+        working-directory: .
+      - run: uv sync --project backend --locked --dev
+        working-directory: .
+      - run: >-
+          backend/.venv/bin/ruff check --config backend/pyproject.toml
+          frontend/src/screens/GameScreenE2eSupport.py
+          docs/features/uf8-full-game-followup/step7-candidate/generate.py
+        working-directory: .
+      - run: >-
+          backend/.venv/bin/ty check --project backend
+          --extra-search-path backend/src --extra-search-path backend/tests
+          --extra-search-path scripts
+          --extra-search-path tests/fixtures/frozen-archive-cases
+          frontend/src/screens/GameScreenE2eSupport.py
+          docs/features/uf8-full-game-followup/step7-candidate/generate.py
+        working-directory: .
+      - run: docker pull postgres:17.11-bookworm
+        working-directory: .
+      - run: pnpm exec playwright install --with-deps chromium
+      - run: pnpm run test:browser

   backend-changes:
     runs-on: ubuntu-latest
