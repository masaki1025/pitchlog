+name: CI
+
+on:
+  pull_request:
+    # edited を含める: PR 本文のチェックボックス編集で core-guard を再評価するため(github-setup.md 2 章)
+    types: [opened, synchronize, reopened, edited]
+  push:
+    branches:
+      - develop
+      - main
+  workflow_dispatch:
+
+concurrency:
+  group: ci-${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+permissions:
+  contents: read
+
+jobs:
+  secrets:
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+      # gitleaks-action が PR コミット一覧を GitHub API で取得するため必要
+      pull-requests: read
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          fetch-depth: 0
+      - uses: gitleaks/gitleaks-action@e0c47f4f8be36e29cdc102c57e68cb5cbf0e8d1e # v3.0.0
+        env:
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          GITLEAKS_ENABLE_COMMENTS: "false"
+          GITLEAKS_ENABLE_UPLOAD_ARTIFACT: "false"
+          GITLEAKS_ENABLE_SUMMARY: "false"
+
+  docs-lint:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+      - uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9 # v9.0.0
+        with:
+          version: "0.8.13"
+          enable-cache: true
+          prune-cache: true
+      - run: uv python install
+      - uses: lycheeverse/lychee-action@e7477775783ea5526144ba13e8db5eec57747ce8 # v2.9.0
+        with:
+          args: --offline --root-dir "$(pwd)" --no-progress --exclude-path docs/legacy './**/*.md'
+      - run: uv run python scripts/check_docs_status.py
+      - run: uv run python scripts/check_design_propagation.py
+      - run: uv run python scripts/check_doc_coverage.py
+
+  core-guard:
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+      pull-requests: read
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          fetch-depth: 0
+      - uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9 # v9.0.0
+        with:
+          version: "0.8.13"
+          enable-cache: true
+          prune-cache: true
+      - run: uv python install
+      - run: uv run python scripts/core_guard.py
+
+  harness:
+    runs-on: ubuntu-latest
+    steps:
+      # manifest.json の source_commit を解決するため fetch-depth: 0 が必須(既定の 1 では到達できない)。
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          fetch-depth: 0
+      # runtime と runner の試験は mise.toml に固定した Node を使う。
+      - uses: jdx/mise-action@3c2e0cf82a5b2e5249f0d3635a4d83d0ae861518 # v4.2.5
+        with:
+          version: "2026.8.6"
+          install: true
+          cache: false
+      - uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9 # v9.0.0
+        with:
+          version: "0.8.13"
+          enable-cache: true
+          prune-cache: true
+      - run: uv python install
+      - run: uv sync --locked --dev
+      - run: uv run python scripts/check_frozen_baselines.py --ci
+      - run: uv run python scripts/check_input_axes_three_way_parity.py --ci
+      - run: uv run python tests/test_census_baseline_check.py
+      - run: uv run ruff check .
+      - run: uv run ty check
+      - run: >-
+          uv run pytest -c pyproject.toml tests/
+          --ignore=tests/domain/boot
+          --ignore=tests/domain/mut
+          --ignore=tests/test_plan_generation.py
+          --ignore=tests/test_step_history_audit.py
+
+  # NFR-018 (e) BOOT-ACTIVATION の機構・負例・正例と、計画・履歴監査を常時実行する。
+  # harness の単体テストとは所有を分け、同じテストを二重実行しない。
+  consistency:
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
