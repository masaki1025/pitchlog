# 開発用ローカル DB の値だけを記載する。本番の接続情報はここにも、コピーして作る .env にも決して書かない。
POSTGRES_USER=pitchlog
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pitchlog
POSTGRES_PORT=5432

# DATABASE_URL は DB コンテナへ渡さず、WSL2 ホスト上で動く backend が使用する。
# パスワードを変えた場合は DATABASE_URL も同時に更新し、URL に含める値は percent-encode する。
DATABASE_URL=postgresql://pitchlog:change-me@127.0.0.1:5432/pitchlog


# --- アプリケーション / Alembic / テストの DB 設定 ---
# 以下のキーは相互 fallback しない。一方が未設定のとき他方の値を使わない。

# アプリの engine のみが読み、アプリ用ロール専用の接続に使う。pooler 経由でもよい。
# SQLAlchemy URL 形式(postgresql+psycopg://...)を指定する。
# 未設定または接続の真正性検査の不一致は、最初の物理接続の確立時に失敗させる。
PITCHLOG_DATABASE_URL=

# アプリの engine のみが読む。true / false を明示する(URL から自動判定しない)。
# true なら engine に prepare_threshold=None を付ける。
# 未設定なら最初の物理接続の確立時に失敗させる。
PITCHLOG_DATABASE_POOLED=

# Alembic の env.py のみが読む。direct connection のみ(pooler を経由しない)。
# 未設定なら alembic の実行を失敗させる。
PITCHLOG_MIGRATION_DATABASE_URL=

# 実 DB テストの管理接続を psycopg が直接読む。SQLAlchemy URL 形式
# (postgresql+psycopg://...)ではなく、libpq URL 形式(postgresql://...)を指定する。
PITCHLOG_TEST_ADMIN_DSN=

# 実 DB テストの被検査ロール接続を psycopg が直接読む。SQLAlchemy URL 形式
# (postgresql+psycopg://...)ではなく、libpq URL 形式(postgresql://...)を指定する。
PITCHLOG_TEST_ROLE_DSN=
