# 開発用ローカル DB の値だけを記載する。本番の接続情報はここにも、コピーして作る .env にも決して書かない。
POSTGRES_USER=pitchlog
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pitchlog
POSTGRES_PORT=5432

# DATABASE_URL は DB コンテナへ渡さず、WSL2 ホスト上で動く backend が使用する。
# パスワードを変えた場合は DATABASE_URL も同時に更新し、URL に含める値は percent-encode する。
DATABASE_URL=postgresql://pitchlog:change-me@127.0.0.1:5432/pitchlog
