# 開発用ローカル DB の値だけを記載する。本番の接続情報はここにも、コピーして作る .env にも決して書かない。
POSTGRES_USER=pitchlog
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pitchlog
POSTGRES_PORT=5432

# DATABASE_URL は DB コンテナへ渡さず、WSL2 ホスト上で動く backend が使用する。
# パスワードを変えた場合は DATABASE_URL も同時に更新し、URL に含める値は percent-encode する。
DATABASE_URL=postgresql://pitchlog:change-me@127.0.0.1:5432/pitchlog


# --- アプリケーション / Alembic の DB 設定(詳細設計 7-3 節)---
# 3 キーは相互 fallback しない。一方が未設定のとき他方の値を使わない。

# アプリの engine のみが読む。pooler 経由でもよい。未設定なら起動を失敗させる。
PITCHLOG_DATABASE_URL=

# アプリの engine のみが読む。true / false を明示する(URL から自動判定しない)。
# true なら engine に prepare_threshold=None を付ける。未設定なら起動を失敗させる。
PITCHLOG_DATABASE_POOLED=

# Alembic の env.py のみが読む。direct connection のみ(pooler を経由しない)。
# 未設定なら alembic の実行を失敗させる。
PITCHLOG_MIGRATION_DATABASE_URL=